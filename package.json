{
  "name": "maternal-mind",
  "main": "client/index.js",
  "version": "1.0.2",
  "description": "Maternal Mind — OB-GYN Learning Platform",
  "scripts": {
    "dev": "tsx server/index.ts",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "expo:web:build": "npx expo export --platform web --output-dir web_dist && node scripts/rewrite-web-build.js",
    "server:build": "esbuild server/index.ts --platform=node --target=node16 --bundle --format=cjs --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "build": "node scripts/build-all.js",
    "build:all": "node scripts/build-all.js",
    "deploy:hostinger": "node scripts/manual-deploy-hostinger.js",
    "start": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "db:seed:packages": "tsx server/scripts/seed-packages.ts",
    "db:standardize:packages": "tsx scripts/standardize-packages-and-pricing.ts",
    "db:fix-currency": "tsx server/scripts/fix-currency-to-pkr.ts",
    "lint": "npx eslint client server shared scripts --ext .ts,.tsx,.js",
    "lint:fix": "npx eslint client server shared scripts --ext .ts,.tsx,.js --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "android": "expo run:android",
    "build:android:store": "npx cross-env EAS_NO_VCS=1 eas-cli build --platform android --profile production --non-interactive",
    "ios": "expo run:ios",
    "test:book-import": "python -m unittest discover -s scripts/tests -p \"test_*.py\" -v",
    "test:book-document": "tsx --test tests/book-document-contract.test.ts",
    "verify:book-release": "python scripts/compile_maternal_mind_book.py --verify-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@native-html/table-plugin": "^5.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@tanstack/react-query": "^5.90.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.debounce": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.9",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "express": "^5.0.1",
    "express-session": "^1.19.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lodash.debounce": "^4.0.8",
    "multer": "^2.1.1",
    "mysql2": "^3.23.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tsx": "^4.20.6",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.0",
    "@types/node": "24.10.0",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "prettier": "3.6.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
