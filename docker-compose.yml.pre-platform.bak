services:
  app:
    build: .
    ports:
      - "5000:5000"
    environment:
      - NODE_ENV=production
      - PORT=5000
      - DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD:-postgres}@db:5432/maternalmind
      - SESSION_SECRET=${SESSION_SECRET:?SESSION_SECRET is required}
      - DB_POOL_MAX=20
      - ALLOWED_ORIGIN=${ALLOWED_ORIGIN:-https://maternalmind.com.pk}
      - LOG_LEVEL=${LOG_LEVEL:-info}
      - BREVO_SMTP_HOST=${BREVO_SMTP_HOST:-}
      - BREVO_SMTP_PORT=${BREVO_SMTP_PORT:-}
      - BREVO_SMTP_USER=${BREVO_SMTP_USER:-}
      - BREVO_SMTP_PASS=${BREVO_SMTP_PASS:-}
      - BREVO_FROM_EMAIL=${BREVO_FROM_EMAIL:-}
      - BREVO_FROM_NAME=${BREVO_FROM_NAME:-}
      # Self-hosted Expo OTA: where the server reads the code-signing private key.
      - CODE_SIGNING_PRIVATE_KEY_PATH=/app/secrets/code-signing-private-key.pem
      - CODE_SIGNING_KEY_ID=${CODE_SIGNING_KEY_ID:-main}
    volumes:
      # Persist user/admin uploads (content images, payment proofs) across
      # container rebuilds & restarts. Without this they live on the container's
      # ephemeral layer and are wiped on every `docker compose down && up`.
      - uploads_data:/app/uploads
      # Published OTA update bundles, dropped here by the GitHub Actions publish
      # pipeline (rsync). A host bind-mount so CI can write to it directly.
      - ./updates:/app/updates
      # Code-signing private key (read-only). Lives only on the host, never baked
      # into the image. Create ./secrets/code-signing-private-key.pem on the VPS.
      - ./secrets:/app/secrets:ro
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 512M
    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1:5000/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  db:
    image: postgres:15-alpine
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-postgres}
      - POSTGRES_DB=maternalmind
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./scripts/pg-init.sql:/docker-entrypoint-initdb.d/01-init.sql:ro
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  postgres_data:
  uploads_data:
