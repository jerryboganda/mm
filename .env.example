# ─── Required ────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/maternal_mind

# JWT signing secret — use a strong random value (≥ 32 chars)
SESSION_SECRET=change-me-to-a-strong-random-secret

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
ALLOWED_ORIGIN=https://maternalmind.com.pk

# ─── Database Pool ───────────────────────────────────────
DB_POOL_MAX=20

# ─── Email (Resend) ─────────────────────────────────────
# Required for email verification & password reset
RESEND_API_KEY=

# ─── Mobile Client ──────────────────────────────────────
# Set in the Expo app via EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=https://your-server.com

# ─── In-App Purchases (RevenueCat) ──────────────────────
# Public API keys from RevenueCat Dashboard → API Keys
# Test key works for sandbox purchases, platform keys for production
EXPO_PUBLIC_RC_API_KEY_TEST=
EXPO_PUBLIC_RC_API_KEY_IOS=
EXPO_PUBLIC_RC_API_KEY_ANDROID=
EXPO_PUBLIC_RC_ENTITLEMENT_ID=maternalmind Premium

# Optional: webhook authentication secret (set same value in RC dashboard)
REVENUECAT_WEBHOOK_SECRET=
