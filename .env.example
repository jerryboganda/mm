# ─── Required ────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/maternal_mind

# JWT signing secret — use a strong random value (≥ 32 chars)
SESSION_SECRET=change-me-to-a-strong-random-secret

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
ALLOWED_ORIGIN=https://maternalmind.com.pk

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# ─── Database Pool ───────────────────────────────────────
DB_POOL_MAX=20

# Docker Compose postgres password (used in DATABASE_URL inside containers)
POSTGRES_PASSWORD=postgres

# ─── Email (Brevo SMTP) ─────────────────────────────────
# Required for email verification & password reset.
# These are fallbacks — settings in the Admin Panel take priority.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Maternal Mind

# ─── Mobile Client ──────────────────────────────────────
# Set in the Expo app via EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=https://your-server.com
