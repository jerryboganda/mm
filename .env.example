# ─── Required ────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/maternal_mind

# JWT signing secret — use a strong random value (≥ 32 chars)
SESSION_SECRET=change-me-to-a-strong-random-secret

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
ALLOWED_ORIGIN=https://maternalmind.com.pk

# ─── Database Pool ───────────────────────────────────────
DB_POOL_MAX=20

# ─── Email (Resend) ─────────────────────────────────────
# Required for email verification & password reset
RESEND_API_KEY=

# ─── SMS (Twilio) ───────────────────────────────────────
# Required for phone OTP verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Mobile Client ──────────────────────────────────────
# Set in the Expo app via EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=https://your-server.com

# ─── In-App Purchases (RevenueCat) ──────────────────────
# Configure in client/lib/purchases.tsx
# REVENUECAT_API_KEY_IOS=
# REVENUECAT_API_KEY_ANDROID=
