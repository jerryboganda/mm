      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-01-011\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1099]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Aptos\", sans-serif; font-size: 16pt'><strong>1</strong></span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Aptos\", sans-serif; font-size: 16pt'><strong>1</strong></span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Aptos\", sans-serif; font-size: 16pt'><strong>. CHRONIC PELVIC PAIN:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1100]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Definition: </strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1101]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Constant pain in lower Abdomen or pelvis of @ least 6months duration not occurring exclusively with menstruation or intercourse and not related to pregnancy.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1102]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1103]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Causes</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> and treatment</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>: </strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1104]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Cyclic pain: </strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1105]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Hormon</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>e</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong> related</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1106]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> t/m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> is</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> OCPs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> for </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3 </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>-</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>6 months before offe</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ring</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>laparoscopy</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1107]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Pelvic congestion</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1108]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>t/m </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>is </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>progestogen, GnRH</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> analogue </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1109]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Endometriosis/Ad</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>n</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>o</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>m</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>yosis</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> - progesterone, GnRH analogues, Danazol, Mirena, COCP.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1110]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Adhesions</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1111]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fine Adhesions:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1112]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No role of </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Adhesiolysis</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1113]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dense</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Adhesions</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1114]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Adhesiolysis improve pain</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1115]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Trapped ovary </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>syndrome </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>suppression</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> with GnRH </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>  </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>analogues or </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>oophorectomy</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1116]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Residual ovary syndrome suppression with GnRH</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> analogues</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>oophorectomy</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1117]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>IBS:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1118]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>50% of CPP t</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>/m Diet + Antispasmodics </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Mebeverin</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>e</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> HCL.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1119]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>interstitial cystitis:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1120]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>38 \u2013 84%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1121]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Musculoskeletal:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1122]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Spas</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>m of </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>pelvic floor </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>muscles, Tender </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>sacroiliac (SI) joint </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>or </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>pubic symphysis</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1123]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Nerve entrapment:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1124]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>3.7% after </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>C/S, </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Pfannenstiel</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> incision.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1125]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Pain Persis</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>t</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> beyond </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>5 weeks \u2013 Gabapenti</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>n, Amitriptyline</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1126]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Psychological factors:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1127]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Child abuse. </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1128]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Investigations:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1129]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>STI </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>screen</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>in all sexually active women</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1130]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Chlamydia, Gonor</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>rh</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>ea </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>screen </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>if suspicions of PiD</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1131]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>TVS \u2013 Endometriosis, Adenomyosis/</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1132]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Laparoscopy</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> \u2013 1/3 or \u00bd r negative</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>,</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> done if t/m fails.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1133]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong> </strong></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>CA-125: Old women &gt; 50yrs history</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> of </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>bloating</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> ea</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>rly satiet</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>y</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> and </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>pelvic </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>pain </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>of</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>&gt; 12</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> episode</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>/year.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1134]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Treatment</strong></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1135]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Co-Dydramo</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>l</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1136]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>paracetamol</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1137]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>LU</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>NA.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1138]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1139]\">\u00a0</p>",
