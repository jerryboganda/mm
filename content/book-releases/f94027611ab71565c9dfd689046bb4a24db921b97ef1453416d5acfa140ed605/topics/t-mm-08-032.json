      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-08-032\" hidden></div>\n<h2 class=\"mm-heading mm-h2 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14344]\" style=\"background-color: #2F5496; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>3</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>2</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>. DIABETES INSIPIDUS</strong></span></h2>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14345]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2 \u2013 4/100,000</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14346]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 50% Di Deteriorate during pregnancy.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14347]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>More in 3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>rd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"0dca617f5dc7f395acc8394e\" data-mm-topic-id=\"t-mm-08-032\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 0dca617f5dc7f395acc8394e\" viewbox=\"0 0 123825 104775\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"cba0fa180cb162d4441846e456a9556b1ac01bed680f62bd7b022f92ec48310f\"><defs><clippath id=\"clip-27bd8f2ad7a2afa466be\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 120015 0 L 120015 97790 L 0 97790 Z\"></path></clippath></defs><g data-mm-object-id=\"27bd8f2ad7a2afa466be\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-27bd8f2ad7a2afa466be)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/866549440181cb5999a3a2f1bc4156e1e0db1172ad3b89b5e1e2b13d8f0bd057.png\" x=\"0\" y=\"0\" width=\"120015\" height=\"97790\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14348]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Self-limiting without major morbidity.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14349]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Herald onset of hepatic dysfunction.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"65540794e43885545823cd66\" data-mm-topic-id=\"t-mm-08-032\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 65540794e43885545823cd66\" viewbox=\"-9525 -9525 3638550 4629150\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"663e5e249f088ddd3e466297871e0e8125302a90cb98ffdaeea45fe4712e88fb\"><defs><clippath id=\"clip-20f168d0ec22f6795080\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 3618132 0 L 3618132 4617495 L 0 4617495 Z\"></path></clippath></defs><g data-mm-object-id=\"20f168d0ec22f6795080\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-20f168d0ec22f6795080)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/1fe8febc86e5ee95789bd2f9fd660e88f168f23a98c719499b845095d858f818.png\" x=\"0\" y=\"0\" width=\"3618132\" height=\"4617495\" preserveaspectratio=\"none\"></image><path d=\"M 0 0 L 3618132 0 L 3618132 4617495 L 0 4617495 Z\" fill=\"none\" stroke=\"#FFFFFF\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14351]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>AHD /    Vasopressinase</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>.</strong></u></span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"9ce268397bb2d32e35a8208e\" data-mm-topic-id=\"t-mm-08-032\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Sour