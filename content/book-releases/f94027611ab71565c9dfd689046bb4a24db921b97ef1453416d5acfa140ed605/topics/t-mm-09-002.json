002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 9da82734b5c874dceb06b2b7\" viewbox=\"-9525 -9525 4572000 2981325\" width=\"480\" height=\"313\" data-mm-natural-width=\"480\" data-mm-natural-height=\"313\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"d1665420ea051287faac38f369d7a37af10007382f6b3b890ed2414cecf28868\"><defs><clippath id=\"clip-df6f6b1f9d561781c6eb\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 4603095 0 L 4603095 2995404 L 0 2995404 Z\"></path></clippath></defs><g data-mm-object-id=\"df6f6b1f9d561781c6eb\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-df6f6b1f9d561781c6eb)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/21b2f3cdd344f16520f8ac926b91bb3168faa18cfc8741a582394148bf2b163c.png\" x=\"0\" y=\"0\" width=\"4603095\" height=\"2995404\" preserveaspectratio=\"none\"></image><path d=\"M 0 0 L 4603095 0 L 4603095 2995404 L 0 2995404 Z\" fill=\"none\" stroke=\"#FFFFFF\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[15763]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[15764]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[15765]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[15766]\" style=\"margin-bottom: 8pt\">\u00a0</p>",
