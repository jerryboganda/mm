      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-09-013\" hidden></div>\n<h3 class=\"mm-heading mm-h3 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16913]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>1.12.</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>PARVOVIRUS</span></h3>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16914]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Incubation period 4 \u2013 14 days.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16915]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>DNA \u2013 virus single stranded DNA.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16916]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Spontaneous replication in diving cells (S \u2013 phase).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16917]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Replicate </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>and </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>inhibit CFU &amp; cause lysis of human erythroid progenitor cells.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16918]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Transmission:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16919]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Droplets borne:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16920]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>50 \u2013 90% house hold contact.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16921]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>20 \u2013 30% in school staff.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16922]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Out Breaks: </strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>in spring.</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16923]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>50% of child bearing are immune.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16924]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16925]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16926]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16927]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16928]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16929]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16930]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16931]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16932]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16933]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16934]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16935]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16936]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16937]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16938]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16939]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16940]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vertical transmission 30% (</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>so</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> TOP not indicated).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16941]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1% of susceptible individuals are infected /year, 1 infection /400 pregnancy, 23 times higher during epidemics.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16942]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Fetal risks:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16943]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Loss rate 9% highest in 2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16944]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrops 3% commonest finding (10 \u2013 20% of non \u2013 immune hydrops).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16945]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reticulocytosis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (&gt; 20% Good prognostic sign)</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16946]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>spontaneous recovery 34% </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16947]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IUD &lt;10% after 4 \u2013 6weeks.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16948]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Diagnosis:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16949]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IgM (3 days \u2013 6m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16950]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pregnancy + rash + arthralgia.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16951]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Exposure</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> history</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16952]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Non \u2013 immune hydrops.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16953]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IUD.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16954]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16955]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>History, examination.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16956]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Counselling + decision to investigate.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16957]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>A/N Booking serum</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16958]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Not available</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Take sample for igG + IgM when rash appears or 21 days after exposure.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16959]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Available </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16960]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16961]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sero positive</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sero</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> negative</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16962]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16963]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>IgM positive</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Infected</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Refer to specialist</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>USG for fetal anemia</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>IUT if needed</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>IgG negative</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>IgM negative</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Susceptle but not infected</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>F/u</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IgG positive</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IgM negative</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reassure</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16964]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16965]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No risk</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16966]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16967]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16968]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16969]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16970]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16971]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Serial USG for up to 12 weeks after confirmed infection.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16972]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Treatment:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16973]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Maternal \u2013 symptomatic treatment.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16974]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrops \u2013 FMU referral.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16975]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Delivery if Gestation is appropriate.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16976]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>FBS with conservative management if </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>reticulocytosis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> positive.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16977]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IUT if anemia on FBS</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16978]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Transmission:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16979]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&lt; 15 weeks = 15%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16980]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>15 \u2013 20 weeks = 25%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16981]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Last </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> = 70%.</span></span></div>\n<div class=\"mm-table-scroll\" role=\"region\" tabindex=\"0\"><table class=\"mm-table\" style=\"border-collapse:collapse;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;\"><colgroup><col style=\"width:131.35pt;\"><col style=\"width:120.15pt;\"></colgroup><tbody><tr><td style=\"white-space:pre-wrap;width:134.55pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><strong>Syphilis</strong></span></p></td><td style=\"white-space:pre-wrap;width:134.6pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><strong>Parvovirus</strong></span></p></td></tr><tr><td style=\"white-space:pre-wrap;width:134.55pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><ul style=\"list-style-type:none;margin:0 0 0 36pt;padding:0;text-indent:-18pt;\"><li data-source-marker-codepoints=\"U+F0B7\" data-source-marker-font=\"Symbol\"><span class=\"list-prefix\" style=\"display:inline-flex;width:18pt;\"><span class=\"list-marker\">\u2022</span><span class=\"list-tab\" aria-hidden=\"true\" data-list-suffix=\"tab\" style=\"flex:1 1 auto;min-width:0;\"></span></span>Still birth + Hydrops</li><li data-source-marker-codepoints=\"U+F0B7\" data-source-marker-font=\"Symbol\"><span class=\"list-prefix\" style=\"display:inline-flex;width:18pt;\"><span class=\"list-marker\">\u2022</span><span class=\"list-tab\" aria-hidden=\"true\" data-list-suffix=\"tab\" style=\"flex:1 1 auto;min-width:0;\"></span></span>Placentomegaly</li><li data-source-marker-codepoints=\"U+F0B7\" data-source-marker-font=\"Symbol\"><span class=\"list-prefix\" style=\"display:inline-flex;width:18pt;\"><span class=\"list-marker\">\u2022</span><span class=\"list-tab\" aria-hidden=\"true\" data-list-suffix=\"tab\" style=\"flex:1 1 auto;min-width:0;\"></span></span>Petechia all over skin</li><li data-source-marker-codepoints=\"U+F0B7\" data-source-marker-font=\"Symbol\"><span class=\"list-prefix\" style=\"display:inline-flex;width:18pt;\"><span class=\"list-marker\">\u2022</span><span class=\"list-tab\" aria-hidden=\"true\" data-list-suffix=\"tab\" style=\"flex:1 1 auto;min-width:0;\"></span></span>VDRAL/RPR = acute syphilis</li><li data-source-marker-codepoints=\"U+F0B7\" data-source-marker-font=\"Symbol\"><span class=\"list-prefix\" style=\"display:inline-flex;width:18pt;\"><span class=\"list-marker\">\u2022</span><span class=\"list-tab\" aria-hidden=\"true\" data-list-suffix=\"tab\" style=\"flex:1 1 auto;min-width:0;\"></span></span>@ 14 weeks = 40 \u2013 50% infection</li></ul></td><td style=\"white-space:pre-wrap;width:134.6pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>Still birth + Hydrops</span></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>No palcentomegaly</span></p><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>No petechial</span></p><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>School out break</span></p><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>80% poly arthritis in mother.</span></p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16982]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16983]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Important facts about perinatal infections:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16984]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Maculopapular rash on palms and soles</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> and</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> periostitis =&gt; </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>syphilis</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16985]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrocephaly</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, I</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ntracerebral</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> calcification, chorioretinitis=&gt; </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Toxo</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>plasmosis</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> treatment sulfadiazine + </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>leucovorin</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16986]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Cataract, SN deafness VSD, PDA, extramedullary hematopoiesis =&gt; </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>rubella</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> B/L hearing loss.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16987]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Microcephaly, PV calcification, deafness    Plt, petechia =&gt; </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>CMV</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> unilateral deafness treatment ganciclovir.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16988]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Limb hypoplasia, </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>cutaneous</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> lesions =&gt; </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>v</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>aricella</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>. </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16989]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Still born + petechial rash = </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>listeria</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16990]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>EONNS + maternal cheese intake = </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>listeria</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16991]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Most common cause of EONNS = </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>GBS</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16992]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> most common cause of EONNS= </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>listeria</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16993]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>CMV</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> trans</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>mission</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>st</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> &amp; 2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>= 40%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16994]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>CMV</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> recent infection = low avidity.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16995]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>CMV</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> infection = high avidity.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16996]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16997]\" style=\"margin-bottom: 8pt\">\u00a0</p>",
