  "topic_id": "t-mm-09-031",
  "book_id": "book-mm-09",
  "title": "18.\tMANAGEMENT OF PREGNANCY AFTER TRACHYLECTOMY:",
  "source_sha256": "f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605",
  "block_count": 1,
  "blocks": [
    {
      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-09-031\" hidden></div>\n<div class=\"mm-heading mm-h2 mm-header-banner mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19276]\" style=\"background-color: #2F5496; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt; padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">18.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>MANAGEMENT OF PREGNANCY AFTER TRACHYLECTOMY:</strong></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19277]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Trachelectomy</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19278]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Removal of CX + surrounding tissues (parametrial/ upper vagina).</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"8ffd5a4e22f8fba24c29fc87\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 8ffd5a4e22f8fba24c29fc87\" viewbox=\"1009650 28575 238125 419100\" width=\"25\" height=\"44\" data-mm-natural-width=\"25\" data-mm-natural-height=\"44\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"3803034156b43435bbfa4edfc044aec9daadb349e52e0531e9173643335d7d3b\"><g data-mm-object-id=\"e4292e2192a72d63a79b\" transform=\"translate(1041621 35256)\"><g transform=\"translate(0 0)\"><path d=\"M 0 282271.5 L 37768.75 282271.5 L 37768.75 0 L 113306.25 0 L 113306.25 282271.5 L 151075 282271.5 L 75537.5 357809 Z\" fill=\"#FFFFFF\" fill-opacity=\"1\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19280]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19281]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Neo C</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ervix</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> formation by joining vagina and </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>isthmus</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (or CX).</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"c6091d560d455cb14836abce\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure c6091d560d455cb14836abce\" viewbox=\"1019175 28575 238125 419100\" width=\"25\" height=\"44\" data-mm-natural-width=\"25\" data-mm-natural-height=\"44\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"d0c2c6240f16f33dd408d78dbc181de41f09dd20ad3936a6763c0762deacce68\"><g data-mm-object-id=\"17503b7128dd6bb62579\" transform=\"translate(1053769 35560)\"><g transform=\"translate(0 0)\"><path d=\"M 0 282257.5 L 37623.75 282257.5 L 37623.75 0 L 112871.25 0 L 112871.25 282257.5 L 150495 282257.5 L 75247.5 357505 Z\" fill=\"#FFFFFF\" fill-opacity=\"1\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19283]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19284]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Insertion of cerclage.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19285]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Risks:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19286]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Spontaneous conception 61%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19287]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Time from surgery to conception 31m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19288]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Live birth 62%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19289]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Miscarriages:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19290]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>st</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 16% (15 \u2013 20%) normal pregnancies.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"94c8dc79fcde2d58033eafda\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 94c8dc79fcde2d58033eafda\" viewbox=\"0 0 142875 114300\" width=\"15\" height=\"12\" data-mm-natural-width=\"15\" data-mm-natural-height=\"12\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"9c801583ea16a676a132e423a4d916b7d5e94f94fa202a884f366dd36d3b69ff\"><defs><clippath id=\"clip-073c3d3bb9b1b602fd76\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 137160 0 L 137160 106680 L 0 106680 Z\"></path></clippath></defs><g data-mm-object-id=\"073c3d3bb9b1b602fd76\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-073c3d3bb9b1b602fd76)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/45228071e3fd7aef148c1758fa6a30bf2f9d90ae1c4d322cb200e608f59cedec.png\" x=\"0\" y=\"0\" width=\"137160\" height=\"106680\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19291]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 7% (4%).</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"d2dcfb12e2ddd1a0f2a9bc38\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure d2dcfb12e2ddd1a0f2a9bc38\" viewbox=\"0 0 142875 114300\" width=\"15\" height=\"12\" data-mm-natural-width=\"15\" data-mm-natural-height=\"12\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"d176262ff9703388eac289203da687b86b7f8cf7c837a8c07db108b520a50c34\"><defs><clippath id=\"clip-c9ea94782ad00fc302c5\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 137160 0 L 137160 106680 L 0 106680 Z\"></path></clippath></defs><g data-mm-object-id=\"c9ea94782ad00fc302c5\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-c9ea94782ad00fc302c5)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/6ced5e1f43a7aca5124b7c6ccf824aa1d461aa42490183450fe3c6b105af74e1.png\" x=\"0\" y=\"0\" width=\"137160\" height=\"106680\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19292]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Term delivery 54.8%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19293]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pre \u2013 Term 30 \u2013 40% up to (45%).</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19294]\" style=\"margin-left: 18pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>More </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>cervix</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> is excised =&gt; more risk of PTL </span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19295]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&gt; 10mm \u2013 risk of PTL.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19296]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Contraception:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19297]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>POP \u2013 ineffective </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>due to </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>loss of CX and mucous plug.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19298]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IUCD \u2013 difficulty in insertion due to isthmic stenosis (insertion of </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>foleyscatheter</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> for 3days after surgery).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19299]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>COC, implants, - UKMEC (2).</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19300]\" style=\"margin-left: 18pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Interval 2 \u2013 3m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> between surgery and pregnancy =&gt;   risk of PTL.</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"04074fca1c74e8c1e638f4c3\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 04074fca1c74e8c1e638f4c3\" viewbox=\"1457325 142875 247650 314325\" width=\"26\" height=\"33\" data-mm-natural-width=\"26\" data-mm-natural-height=\"33\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"9929b3f43eee6ec8c6ccdb1f223394292507533a3977df7a6e2ccc87d6de06bb\"><defs><marker id=\"arrow-end-89bba75f46ceb5dc7f1a\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"89bba75f46ceb5dc7f1a\" transform=\"translate(1577975 233870)\"><g transform=\"translate(0 0) translate(3810 71437.5) rotate(0) scale(-1 -1) translate(-3810 -71437.5)\"><path d=\"M 0 0 L 7620 142875\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-89bba75f46ceb5dc7f1a)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19301]\" style=\"margin-left: 18pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>6m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> C/C is recommended after surgery.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19302]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>ANC:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19303]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT \u2013 consultant led care.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19304]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vaginal progesterone, 200mg, B.D, 12 \u2013 36weeks.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19305]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fortnightly serial scan of isthmic length by expert.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19306]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No need of another cerclage.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19307]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Urine examination and vaginal swabs for culture and sensitivity booking then @ 16 \u2013 24 weeks. Repeat tests if clinically indicated.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19308]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Antibiotic cover if infection noted.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19309]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avoid vaginal examination \u2013 unnecessary.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19310]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avoid sex</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ual</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> inter course from 20 weeks as it    es infections.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"681ccb5efabaf38a458d705c\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 681ccb5efabaf38a458d705c\" viewbox=\"942975 133350 247650 304800\" width=\"26\" height=\"32\" data-mm-natural-width=\"26\" data-mm-natural-height=\"32\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"0d1b087eb264d074e3c8581c92108f67cfc6b4888a377785bafc4d39c4d450dc\"><defs><marker id=\"arrow-end-2945d292c461eaac12f8\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"2945d292c461eaac12f8\" transform=\"translate(1067435 219191)\"><g transform=\"translate(0 0) translate(3810 71437.5) rotate(0) scale(-1 -1) translate(-3810 -71437.5)\"><path d=\"M 0 0 L 7620 142875\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-2945d292c461eaac12f8)\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19311]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avoid exercise, weight lifting in 2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"d5b9bf3895e7b17f1df282d8\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure d5b9bf3895e7b17f1df282d8\" viewbox=\"0 0 142875 114300\" width=\"15\" height=\"12\" data-mm-natural-width=\"15\" data-mm-natural-height=\"12\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"f406ae3f6359122e1d6a3a1525d77d7e4a664e1601b9f13140140ca4c3c1d4ef\"><defs><clippath id=\"clip-bfd40ec1c587317f07f4\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 137160 0 L 137160 106680 L 0 106680 Z\"></path></clippath></defs><g data-mm-object-id=\"bfd40ec1c587317f07f4\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-bfd40ec1c587317f07f4)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/9e52ad8e17d87b0ae15208a5dd34fe380e7f11d3736cd8f34e76ac947552ec76.png\" x=\"0\" y=\"0\" width=\"137160\" height=\"106680\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19312]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avoid elective dental work in pregnancy as it    es PTL.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"51aea89af9f40971348cba54\" data-mm-topic-id=\"t-mm-09-031\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 51aea89af9f40971348cba54\" viewbox=\"952500 142875 247650 314325\" width=\"26\" height=\"33\" data-mm-natural-width=\"26\" data-mm-natural-height=\"33\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"ae79a75a1209abbbe3edfba26201927abd2287f2b07fb20c6a51124c35e4c45f\"><defs><marker id=\"arrow-end-9a4ba820ad9d4d786d62\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"9a4ba820ad9d4d786d62\" transform=\"translate(1074886 233252)\"><g transform=\"translate(0 0) translate(3810 71437.5) rotate(0) scale(-1 -1) translate(-3810 -71437.5)\"><path d=\"M 0 0 L 7620 142875\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-9a4ba820ad9d4d786d62)\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19313]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>A/B + steroids if PPROM.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19314]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>EL \u2013 ISCS @ 37 weeks.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19315]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Planned + </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pre labour</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> C/S is recommended</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19316]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Lower segment not formed so upper segment</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> c section</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19317]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Transverse incision/ classical incision.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19318]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19319]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19320]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19321]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19322]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19323]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19324]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19325]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19326]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19327]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[19328]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>",
