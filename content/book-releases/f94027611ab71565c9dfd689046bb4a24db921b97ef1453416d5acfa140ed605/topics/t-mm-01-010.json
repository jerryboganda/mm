      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-01-010\" hidden></div>\n<h2 class=\"mm-heading mm-h2 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1073]\" style=\"background-color: #2F5496; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>10</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>. POST</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong> </strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>MENOPAUSAL</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong> </strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>BLEEDING:</strong></span></h2>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1074]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Incidence = 10%.</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1075]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">1.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><em><strong>Causes:</strong></em></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1076]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>90% benign</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1077]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>10% malignant </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1078]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Atrophic vaginitis/ Endometritis = 75%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1079]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>HRT = 20%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1080]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Polyps = 12%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1081]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Hyperplasia</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> = 10%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1082]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>CA = 10%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1083]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Prolapse</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1084]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Evaluation</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1085]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Aptos\", sans-serif; font-size: 12pt'>Local examination</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1086]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Aptos\", sans-serif; font-size: 12pt'> TVS</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1087]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Aptos\", sans-serif; font-size: 12pt'>Endometrial Biopsy</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Aptos\", sans-serif; font-size: 12pt'> if</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Aptos\", sans-serif; font-size: 12pt'> ET &gt; 5mm</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1088]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Aptos\", sans-serif; font-size: 12pt'>Hysteroscopy</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1089]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">2.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><em><strong>Management:</strong></em></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1090]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">1.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Endometrial thickness</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>&lt; 5mm =&gt; Endometrial</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> atrophy</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> \u2013 No t/m required</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1091]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">2.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Atrophic vagina: local E &amp; vaginal moisturizers.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1092]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">3.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Polyps + Submucosal-Fibroids =&gt; Hysteroscopic resection and Biopsy</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1093]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">4.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Hyperplasia \u2013 </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Hysterectomy</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1094]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">5.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Malignancy =&gt; refer to</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>oncologist.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1095]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">6.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Polyp</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1096]\" style=\"margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>&gt;remove if symptomatic or more than 1cm</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1097]\" style=\"margin-left: 54pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1098]\" style=\"margin-bottom: 8pt\">\u00a0</p>",
