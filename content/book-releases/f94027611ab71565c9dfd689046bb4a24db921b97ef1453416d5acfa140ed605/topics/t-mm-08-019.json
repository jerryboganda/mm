      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-08-019\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12798]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong> </strong></span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>PKU - PHENYLKETONURIA</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12799]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Autosomal Reces</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>sive 1/10,000.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12800]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>More in Turkish &amp; Irish ethnicity.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12801]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Deficiency of PAH </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>phenylalanine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> hydroxylase enzyme.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12802]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>PKU \u2013 most common in born error of Metabolism.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12803]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Phenylalanine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> is converted to </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>\u2013 tyrosine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> with the help of enzyme PAH</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12804]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>PKU in Maternal blood Causes</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12805]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IUGR</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12806]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Heart defects 7 \u2013 10%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12807]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Development defects</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12808]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Rash</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12809]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Microcep</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ha</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ly.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12810]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Facial </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>dysmo</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>rph</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ism</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> =&gt; like FAS </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>(</span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>fetal Alcohol syndrome</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12811]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Types:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12812]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Classical</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12813]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Absent PAH.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12814]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Phenylalanine levels &gt; 1200 </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>\u00b5</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>o</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>l/L</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12815]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Non \u2013 Classical:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12816]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mild to moderate PAH.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12817]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Pathogenesis:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12818]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Phenylalanine level \u2013 cross placenta.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12819]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12820]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Teratogenesis, behavioral/ developmental problems.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12821]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12822]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tyrosine -&gt;    melanin -&gt; fair skin, </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>blue</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> eyes.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12823]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Treatment of PKU:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12824]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Phenylalanine restricted diet (avoid animal </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>proteins</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12825]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12826]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Management:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12827]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pre \u2013 pregnancy: Contraception till optimal Phenylalanine levels.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12828]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Target phe</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>nylalanine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (120 \u2013 300 </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>\u00b5</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>o</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>l/l).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12829]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Discontinue contraception if phe</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>nylalanine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> level &lt; 350.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12830]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Allow pregnancy when 3 \u2013 4 levels of P</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>henylalanine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> &lt; 350.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12831]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>ANC:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12832]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Phe</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>nylalanine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> level 3 times/ week.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12833]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12834]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dietitian.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12835]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Obstetrician</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12836]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Midwife.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12837]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Amino acid, trace minerals.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12838]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>@ Smoking &amp; 20 \u2013 22weeks.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12839]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tyrosine </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u>supplementation</u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> after 16 weeks.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12840]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12841]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dairy egg, chicken, fish, Beans, Oats, Wheats, nuts.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12842]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Weight gain = microcephaly </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12843]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Link between weight gain and microcephaly.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12844]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Delivery:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> obs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tetric</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> indicat</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ion</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12845]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Unplanned pregnancies:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Anomaly scan @ FMU.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12846]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Fetal Monitoring</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12847]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Anomaly scan.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12848]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Echo</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12849]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Doppler \u2013 IUGR.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12850]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Microcep</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>ha</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>ly:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12851]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Diagnosed @ 28 weeks.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12852]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>HC &lt; 2.5 SD = Suspect.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12853]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>HC &lt; 5.5 SD = Confirmed.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12854]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Breast Feeding safe.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12855]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Neonatal PKU:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12856]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Testing @ D \u2013 5.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12857]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Psychological Assessment:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12858]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>@ 18</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>months</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12859]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Then @</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>4, 8</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> and</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 14</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> years</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12860]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>To access cognition and behavior.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12861]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dietary restriction for 5 \u2013 6 years.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12862]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12863]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12864]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12865]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12866]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12867]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12868]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12869]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12870]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12871]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12872]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12873]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12874]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12875]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12876]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12877]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12878]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/docume