      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-06-007\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8522]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>7. </strong></span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>UTERINE PREFORATION:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8523]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>.002 \u2013 1.7%</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8524]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Hystero</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>scopy</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong> = 1.6%</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8525]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>15% perforation cause visceral damage</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8526]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dilator</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&lt; </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5mm scope</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Curette</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Coil insertion</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Polyp forceps</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3 \u2013 7.5% Bowel damage.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8527]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>instruments used</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&gt; 5mm scope</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avulsion attempted</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Resection loop/ laser</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Surgical TOP</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8528]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8529]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8530]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8531]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Immediate management</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Alert Team</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Observation</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>A/B</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u>+</u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>catheter</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u>+</u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> senior help</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Alert Team</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Observation</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>A/B</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>catheter</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> senior help</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8532]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8533]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8534]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8535]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u><strong>Laparoscopy</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Irrespective of patient is stable/ Bleeding</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Small</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Large </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Perforation</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>perforation </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- No Bleeding</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>&gt; 1.5cm.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>or i</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>njuries</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>.</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Hagger 9,10</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Bleeding</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Other </span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>injuries</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Bleeding </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Pain</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Patient is stable</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Yes </span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>No </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8536]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8537]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8538]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8539]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8540]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8541]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8542]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8543]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Small injuries</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>laparotomy if</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'>repair</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Repair laparoscopically</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>not possible by</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Laparoscopy or other</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Injuries</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>                  </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>admit for 24 hours</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8544]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8545]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Discharge when stable and arrange F/U</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Risk management and incident reporting</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8546]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8547]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8548]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8549]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>If initial procedure is not complete @ time of perforation, then complete under direct laparoscopic vision.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8550]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>TOP most common cause of perforation \u2013 (5%).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8551]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Recognition:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8552]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Extention of instrument beyond limit</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8553]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Loss of vision</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8554]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Collapsed uterus</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8555]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Large deficient of distetion media.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8556]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Common Sites</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>: </strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8557]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Anterior wall 40%.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8558]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Cervical canall 36%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8559]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Right lateral wall 21%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8560]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Left lateral wall 17%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8561]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Post wall 13%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8562]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fundus 13%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8563]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Common instruments:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8564]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Suction cannula 51%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8565]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dilater 24%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8566]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Curette 10%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8567]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8568]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8569]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8570]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8571]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[8572]\">\u00a0</p>\n<p class=\"mm-p