-figure-id=\"a36bc6ab716442b7cd22345b\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure a36bc6ab716442b7cd22345b\" viewbox=\"990600 123825 228600 457200\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"2b6d79216cc3e1603a92c3692cb8de3bedb04a0857db9a62f157e84df4516234\"><defs><marker id=\"arrow-end-96c54179bd14f0364d64\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"96c54179bd14f0364d64\" transform=\"translate(1111348 172134)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 309489\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-96c54179bd14f0364d64)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16656]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16657]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>High CNS disease progression &amp; HIV progression</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"4bc476783e0dbe8483c31660\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 4bc476783e0dbe8483c31660\" viewbox=\"981075 323850 238125 466725\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"b1515725773bb49f050923ff4435f35cd5d9bb55b2507aa4c9b0026f97a74f73\"><defs><marker id=\"arrow-end-6adb769ca2f17b5cdd6c\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"6adb769ca2f17b5cdd6c\" transform=\"translate(1108710 377239)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 309245\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-6adb769ca2f17b5cdd6c)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16658]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16659]\" style=\"margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Treatment should be given for CMV.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16660]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Manifestations:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16661]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Most \u2013 asymptomatic.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16662]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>15% hearing loss.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16663]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>10% symptomatic.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16664]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hepatosplenomegaly.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16665]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Chorioretinitis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16666]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Petechial </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>purpura</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, jaundice.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16667]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Microcephaly.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16668]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>SGA.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16669]\" style=\"margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16670]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Treatment:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16671]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ganciclovir</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> protects against hearing loss and developmental delays.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16672]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Oral valacyclovir (20% people got reaction) it reduces risk of transmission to baby.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16673]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hyper immunoglobulin \u2013 investigational.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16674]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vaccination:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16675]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Under trial.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16676]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Delivery:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16677]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>According to obstetric indications.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16678]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Patient education:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16679]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>To all women.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16680]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>B.F:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16681]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Safe except </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>immune </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>compromised.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16682]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16683]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16684]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16685]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16686]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16687]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-sou