      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-09-008\" hidden></div>\n<div class=\"mm-heading mm-h3 mm-header-banner mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16586]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt; padding-left: 108pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">7.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'> </span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>C</span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>YTOMEGALO</span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>VIRUS</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16587]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Most common congenital infection \u2013 0.5%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16588]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>40 \u2013 60% seropositive.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16589]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>37% Neonates born with infection.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16590]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>10% have clinical manifestation.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16591]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>40% transmission in 1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>st</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, 2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"04f087b6981e8a52bf87a613\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 04f087b6981e8a52bf87a613\" viewbox=\"0 0 152400 85725\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"e6dca98244b0b48375fe0e29c777c47ce9845af1cb127d05fd513d4a771162cf\"><defs><clippath id=\"clip-07b2ea558b8be9d1c5e6\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 146685 0 L 146685 81915 L 0 81915 Z\"></path></clippath></defs><g data-mm-object-id=\"07b2ea558b8be9d1c5e6\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-07b2ea558b8be9d1c5e6)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/04b4937cb06d231394b97c7ea7b157eb6895affe291858fd92e4f16ea74f5806.png\" x=\"0\" y=\"0\" width=\"146685\" height=\"81915\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16592]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>80% transmission in 3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>rd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"b18afb531fe5e80d3454056f\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure b18afb531fe5e80d3454056f\" viewbox=\"0 0 152400 85725\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"b6be5ad4daa2fec915e6c7675f334badbb1cccc3551136aebe8bac66e5546202\"><defs><clippath id=\"clip-b748aa782b6bb0540e6c\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 146685 0 L 146685 81915 L 0 81915 Z\"></path></clippath></defs><g data-mm-object-id=\"b748aa782b6bb0540e6c\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-b748aa782b6bb0540e6c)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/6be752698ec560d5dee7e968f891feeb4b61b229fec73aef2c71a7ed2dc82afc.png\" x=\"0\" y=\"0\" width=\"146685\" height=\"81915\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16593]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>P</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> infection cause miscarriage.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16594]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Transmission </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>increases</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> with Gestation.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16595]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Infectivity </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>decreases</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> with Gestation.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16596]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Transmission by saliva, body fluids</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16597]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Screening:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16598]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Symptomatic women or USG suggestive of CMV other causes of placental insufficiency ruled out.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"7c215ff5f3e0a85344b04a87\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 7c215ff5f3e0a85344b04a87\" viewbox=\"1019175 523875 247650 800100\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"ad7170d4d0c39a9c052d6258d72dee09b8ae032e05cfa282263738b63dc23baa\"><defs><marker id=\"arrow-end-65a94f75d875f40a007b\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"65a94f75d875f40a007b\" transform=\"translate(1145350 568325)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 6985 647065\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-65a94f75d875f40a007b)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16599]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16600]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16601]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>=</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&gt; IgG</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Ig</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>M alone</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>are </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>unreliable</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>    </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16602]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>=&gt; positive IgG and </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IgM with</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> low avidity show</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>       </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>recent infection:</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 3-4 months</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16603]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>=&gt; high avidity </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>suggests</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> old infection &gt;3 months </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16604]\" style=\"text-align: center\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Assessment of fetal infection:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16605]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">1.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>USG</strong></em></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16606]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>20% detection.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16607]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Unreliable, serial USG 2 \u2013 weeks.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16608]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">2.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Amniocent</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>esis</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>:</strong></em></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16609]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>6 \u2013 8 weeks after infection &amp; after 20 weeks GA.</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"552ccc18d5cc2299965fae55\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 552ccc18d5cc2299965fae55\" viewbox=\"1485900 -19050 209550 533400\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"7b5d1c4a238b46e228990d895b51c0af60fdcf759f814e024986c4e13b925c7a\"><defs><marker id=\"arrow-end-e3ea33c30ee9cf847a0e\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"e3ea33c30ee9cf847a0e\" transform=\"translate(1568548 30920)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 14067 386861\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-e3ea33c30ee9cf847a0e)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16611]\" style=\"margin-left: 72pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16612]\" style=\"margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Positive CMV</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"07679a682a25223bb2a7b1a9\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 07679a682a25223bb2a7b1a9\" viewbox=\"1533525 85725 209550 533400\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"4e2b5b2fc420986f6b840ef20b2163b17cef979f4ad3afe4631f1883d65274eb\"><defs><marker id=\"arrow-end-6fa057444164f8847ec5\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"6fa057444164f8847ec5\" transform=\"translate(1620569 134620)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 13970 386715\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-6fa057444164f8847ec5)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16613]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16614]\" style=\"margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Quantitative DNA</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16615]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>      </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Positive</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> on Amniocentesis or USG</strong></u></span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"e333b28984c02ea91a14c2da\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure e333b28984c02ea91a14c2da\" viewbox=\"1504950 142875 238125 409575\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"d1acae1b270acd0e8bf73500175b83cd8b9d5d43d20ea6cd18bddd0c6480eeee\"><defs><marker id=\"arrow-end-3f0e73efabb921f0dfd7\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"3f0e73efabb921f0dfd7\" transform=\"translate(1634685 194505)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 246185\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-3f0e73efabb921f0dfd7)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16616]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16617]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>counselling regarding risk of symptomatic disease.</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"adb10aa875f6c6211fa5d8b9\" data-mm-topic-id=\"t-mm-09-008\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure adb10aa875f6c6211fa5d8b9\" viewbox=\"1533525 161925 228600 400050\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"12df9c718fd87bd0779602acafaa4539d5c4704acb97e2f4ac4b6741a4bb8042\"><defs><marker id=\"arrow-end-2df080879e25d41fa5c6\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"2df080879e25d41fa5c6\" transform=\"translate(1658620 212676)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 245745\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-2df080879e25d41fa5c6)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16618]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16619]\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16620]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sensorineural deafness 12%, Leading cause of non \u2013 genetic deafness.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16621]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>CP \u2013 8%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16622]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5 \u2013 20% symptomatic infants.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16623]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Infants can have</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16624]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Jaundice, petechial rash Hepatosplenomegaly, microcephaly, SGA.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16625]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Management:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16626]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Asymptomatic fetus mild to moderate disease:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16627]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Expectant.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16628]\" style=\"margin-bottom: 8pt; padding-left: 108pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">1.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Detailed Examination of ear and eyes after birth and postnatal t/m and lifelong follow</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>up of affected neonat</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>e</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16629]\" style=\"margin-bottom: 8pt; padding-left: 108pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">2.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Examination of plac</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>enta</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16630]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Symptomatic:</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16631]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mild, mod, severe disease.</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16632]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Top</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16633]\" style=\"margin-bottom: 8pt; padding-left: 90pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Post </span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>mortem</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'> examination.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16634]\" style=\"margin-bottom: 8pt; padding-left: 90pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Examination of placenta.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16635]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">3.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>MRI </strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>+</strong></em></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>:</strong></em></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16636]\" style=\"margin-bottom: 8pt\"><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>B/L periventricular calcifications.</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16637]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>@ 28 \u2013 32 weeks.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16638]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Repeat 3 \u2013 4 weeks if needed.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16639]\" style=\"text-align: center; margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16640]\" style=\"text-align: center; margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16641]\" style=\"text-align: center; margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16642]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16643]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16644]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16645]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16646]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<figure class=\"mm-figure