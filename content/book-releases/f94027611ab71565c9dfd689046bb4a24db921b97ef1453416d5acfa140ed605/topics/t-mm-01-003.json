i\", sans-serif;font-size:12pt'>occlusion</span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'> &amp; sepsis</span></p><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>2. unconfirmed diagnosis</span></p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>2.pedunculated sub serosal </span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>fibroids requiring</span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'> laparoscopic retrieval</span></p><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>3. Pregnancy</span></p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>3. Fertility wishes</span></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>4. Asymptomatic fibroids.</span></p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>5. If not consenting for hysterectomy</span></p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[653]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>Pre \u2013 Treatment Assessment:</strong></em></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[654]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT including inte</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>rvention </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>radiologist</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[655]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mapping by USG/MRI</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[656]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Rule out Pregnancy, infection</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[657]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Remove IUD</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[658]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Written leaflet + consent</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[659]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[660]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[661]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>Procedure:</strong></em></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[662]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>conscious sedation</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[663]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Anti-spasmodic+ analgesics</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[664]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vital Monitor</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ing</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> + </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Resuscitation</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Facilities</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> should be available</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[665]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Catheter enters rt </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>femoral</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> artery percutaneously. From Femoral</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> it goes</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> to</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> External iliac</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>artery and then to </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>common iliac</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Artry. From common iliac it goes to </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>the internal iliac and finally </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>to the </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>uterine artery.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[666]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>embolic agent 300-75</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>0micrometer</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[667]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>polyvinyl alcohol is agent of choice</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[668]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>4 \u2013 5 fr catheter is used.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[669]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>COMPLICATIONS:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[670]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>1. Immediate:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[671]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>hematoma of Groin</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[672]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Thrombosis, Dissection, Aneurysm</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[673]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reaction to contrast media </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[674]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>pain</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[675]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>non </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tar</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>geted</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> embolization</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[676]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[677]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>2. Early complications:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[678]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>    Within 30 days</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[679]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>UTI</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[680]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vaginal d</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ischarge</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>-Self </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>limiting</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[681]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Post embolization syndrome</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[682]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>pain, fever, nausea, Malaise</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[683]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>increased inflammatory </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>markers,  </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>TLC</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"dd600aca4e80afbf7a4c03f8\" data-mm-topic-id=\"t-mm-01-003\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure dd600aca4e80afbf7a4c03f8\" viewbox=\"2305050 133350 257175 304800\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"3b1a903bdfbe4c330cc99372124725e83f7a35f75c1ef404a0f80a4b2f79ff6b\"><defs><marker id=\"arrow-end-b264a1984bc0d7bcf991\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"b264a1984bc0d7bcf991\" transform=\"translate(2434427 221615)\"><g transform=\"translate(0 0) translate(2263.5 76954.5) rotate(0) scale(1 -1) translate(-2263.5 -76954.5)\"><path d=\"M 0 0 L 4527 153909\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-b264a1984bc0d7bcf991)\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[684]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Self-limiting 10 days - 2 weeks</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[685]\" style=\"margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Due to release of inflammatory mediators from necrosis of fibroids</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[686]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>treatment:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[687]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3-5% may requir</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>e a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>dmission</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[688]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Analgesics </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[689]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>i/V fluids</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[690]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[691]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Pregnancy After UAE:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[692]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Miscarriage</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[693]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>SGA</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[694]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>PPH</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"20ab4006a388011877bb43bb\" data-mm-topic-id=\"t-mm-01-003\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 20ab4006a388011877bb43bb\" viewbox=\"1200150 123825 247650 304800\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"ac993b3a519199831952c0abd3c75f7983047685bc859758a415b24d97b26694\"><defs><marker id=\"arrow-end-63a2e71071dddfd9b93a\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"63a2e71071dddfd9b93a\" transform=\"translate(1321387 209810)\"><g transform=\"translate(0 0) translate(2263.5 76954.5) rotate(0) scale(1 -1) translate(-2263.5 -76954.5)\"><path d=\"M 0 0 L 4527 153909\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-63a2e71071dddfd9b93a)\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[695]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Caesarian section</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[696]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abnormal presentation.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[697]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>3. Late complications:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[698]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>    beyond 30 days</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[699]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vaginal infection 16%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[700]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fibroid impaction 10%, more in sub mucosal may require Hysteroscopic retrieval.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[701]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Endometritis 0.5%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[702]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Amenorrhea 1.5- 7%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[703]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ovarian dysfunction</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[704]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Recurrence of symptoms, requiring Hysterectomy 25%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[705]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sexual dysfunction, improves 26%, Deteriorate 10%, rest unchanged.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[706]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>MR</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>g</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>FUS:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[707]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>7-fold</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> re intervention </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>with</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> in 12months.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[708]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in size</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> @ 12months.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"ef2f8d54f6a10304048732df\" data-mm-topic-id=\"t-mm-01-003\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure ef2f8d54f6a10304048732df\" viewbox=\"1200150 -9525 228600 285750\" preserveaspectratio=\"xMidYMid meet\" data-