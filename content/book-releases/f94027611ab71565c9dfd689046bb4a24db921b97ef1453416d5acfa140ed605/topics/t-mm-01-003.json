      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-01-003\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[646]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>3. U</strong></span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>TERINE ARTERY EMBOLIZATION:</strong></span><span class=\"mm-run\" style='color: ##FF0000; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong> </strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[647]\"><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> &gt;</strong></span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>80-90% symptoms control</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[648]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&gt;</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>40-70</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>% </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>decrease</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in volume/size</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[649]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>INDICATIONS:</strong></em></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[650]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fibroid with comorbidities contraindicating surgery</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[651]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Jehovah\u2019s witness</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[652]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fibroid + Adenomyosis (after counselling) causing HMB, pressure symptoms on urinary or gastrointestinal symptoms.</span></p>\n<div class=\"mm-table-scroll\" role=\"region\" tabindex=\"0\"><table class=\"mm-table\" style=\"border-collapse:collapse;table-layout:fixed;margin-left:0pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;\"><colgroup><col style=\"width:106.1pt;\"><col style=\"width:148.8pt;\"></colgroup><tbody><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">contraindication    </p></td><td style=\"white-space:pre-wrap;width:148.8pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Relative Contraindication</p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">1. PID</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">1.large I/cavity fibroids risk of cervix occlusion &amp; sepsis</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">2. unconfirmed diagnosis</p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">2.pedunculated sub serosal fibroids requiring laparoscopic retrieval</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">3. Pregnancy</p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">3. Fertility wishes</p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">4. Asymptomatic fibroids.</p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr data-mm-row-height-twips=\"300\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:106.1pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">5. If not consenting for hysterectomy</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:148.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[653]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>Pre \u2013 Treatment Assessment:</strong></em></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[654]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT including inte</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>rvention </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>radiologist</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[655]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mapping by USG/MRI</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[656]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Rule out Pregnancy, infection</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[657]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Remove IUD</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[658]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Written leaflet + consent</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[659]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[660]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[661]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>Procedure:</strong></em></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[662]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>conscious sedation</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[663]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Anti-spasmodic+ analgesics</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[664]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vital Monitor</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ing</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> + </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Resuscitation</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Facilities</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> should be available</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[665]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Catheter enters rt </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>femoral</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> artery percutaneously. From Femoral</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> it goes</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> to</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> External iliac</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>artery and then to </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>common iliac</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Artry. From common iliac it goes to </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>the internal iliac and finally </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>to the </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>uterine artery.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[666]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>embolic agent 300-75</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>0micrometer</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[667]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>polyvinyl alcohol is agent of choice</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[668]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>4 \u2013 5 fr catheter is used.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[669]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>COMPLICATIONS:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[670]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>1. Immediate:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[671]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>hematoma of Groin</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[672]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Thrombosis, Dissection, Aneurysm</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[673]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reaction to contrast media </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[674]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>pain</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[675]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>non </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tar</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>geted</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> embolization</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[676]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[677]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>2. Early complications:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[678]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>    Within 30 days</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[679]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>UTI</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[680]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vaginal d</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ischarge</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>-Self </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>limiting</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[681]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Post embolization syndrome</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[682]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>pain, fever, nausea, Malaise</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[683]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>increased inflammatory </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>markers,  </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>TLC</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[684]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Self-limiting 10 days - 2 weeks</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[685]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Due to release of inflammatory mediators from necrosis of fibroids</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[686]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>treatment:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[687]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3-5% may requir</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>e a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>dmission</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[688]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Analgesics </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[689]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>i/V fluids</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[690]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[691]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Pregnancy After UAE:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[692]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Miscarriage</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[693]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>SGA</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[694]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'