bject-id=\"7f5528b4d68afd1a9c7a\" transform=\"translate(1382958 6350)\"><g transform=\"translate(0 0) translate(2540 73342.5) rotate(0) scale(-1 -1) translate(-2540 -73342.5)\"><path d=\"M 0 0 L 5080 146685\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-7f5528b4d68afd1a9c7a)\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12074]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>ADAM = </strong></u></span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"1998b92a1a230cde67a6049d\" data-mm-topic-id=\"t-mm-08-009\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 1998b92a1a230cde67a6049d\" viewbox=\"1362075 -19050 247650 304800\" width=\"26\" height=\"32\" data-mm-natural-width=\"26\" data-mm-natural-height=\"32\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"672ac48d58d5d11e1bac638d953147ee143c02df68d1a7c47a9d8a3f1848aaa9\"><defs><marker id=\"arrow-end-2f3661c3e8b9ab6864a4\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"2f3661c3e8b9ab6864a4\" transform=\"translate(1482725 26742)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 3810 160655\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-2f3661c3e8b9ab6864a4)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12075]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Low dose Aspirin:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12076]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>More effective before 16 weeks</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12077]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>start after 12 weeks 75 \u2013 150mg.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12078]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>8% reduction in PTB.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12079]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>14% reduction in neonatal death.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12080]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>10% reduction in IUGR</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12081]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>17% reduction in Pre \u2013 Eclampsia</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12082]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Mechanism of Action of Aspirin:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12083]\" style=\"text-align: center; margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Inhibits cyclooxygenase</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"61b9943d2abba8d79030b6f3\" data-mm-topic-id=\"t-mm-08-009\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 61b9943d2abba8d79030b6f3\" viewbox=\"1952625 133350 247650 304800\" width=\"26\" height=\"32\" data-mm-natural-width=\"26\" data-mm-natural-height=\"32\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"3fa6a1401810043216aa6ea26d17cebaa40561ec238a44ab6d4a05360f5cc715\"><defs><marker id=\"arrow-end-3b35154866b0ffa08f1f\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"3b35154866b0ffa08f1f\" transform=\"translate(2077085 181465)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 3810 160655\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-3b35154866b0ffa08f1f)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12084]\" style=\"text-align: center; margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Inhibit production of</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"e4a8025e870ea0aa8f6160a3\" data-mm-topic-id=\"t-mm-08-009\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure e4a8025e870ea0aa8f6160a3\" viewbox=\"1114425 142875 1800225 628650\" width=\"189\" height=\"66\" data-mm-natural-width=\"189\" data-mm-natural-height=\"66\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"41765b8a5eac6e0c6f6efca626ee181d15f4f17ab77bd7bd9ec3e6d55123a18f\"><defs><marker id=\"arrow-end-1f81a72f53e5b90670d5\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"15837595ae335c7a5400\" transform=\"translate(2078073 156172)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 161534\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g><g data-mm-object-id=\"0d22fd9b9c39895bb815\" transform=\"translate(1121120 306705)\"><g transform=\"translate(0 0) translate(836295 9842.5) rotate(0) scale(1 -1) translate(-836295 -9842.5)\"><path d=\"M 0 0 L 1672590 19685\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g><g data-mm-object-id=\"1f81a72f53e5b90670d5\" transform=\"translate(2793365 302605)\"><g transform=\"translate(0 0) translate(2857.5 180340) rotate(0) scale(-1 1) translate(-2857.5 -180340)\"><path d=\"M 0 0 L 5715 360680\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-1f81a72f53e5b90670d5)\"></path></g></g></svg></figure>\n<figure class=\"mm-figure\" data-mm-figure-id=\"0d9d99e0e12326339dc9ef02\" data-mm-topic-id=\"t-mm-08-009\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 0d9d99e0e12326339dc9ef02\" viewbox=\"990600 -47625 247650 523875\" width=\"26\" height=\"55\" data-mm-natural-width=\"26\" data-mm-natural-height=\"55\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"5dc5bb492cf912cdac3ca3f37aa5a7007c8b8418506ce9bfc77e6fc56346e114\"><defs><marker id=\"arrow-end-67ec4d0014f1fc6508ff\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"67ec4d0014f1fc6508ff\" transform=\"translate(1115695 4155)\"><g transform=\"translate(0 0) translate(2857.5 180340) rotate(0) scale(-1 1) translate(-2857.5 -180340)\"><path d=\"M 0 0 L 5715 360680\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-67ec4d0014f1fc6508ff)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12086]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>1. Prostacyclin</strong></em></span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>2. Thromboxane A2</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12087]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Found in Endothelium</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>       </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Found in platelets</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12088]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Cause Vasodilatation</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>         </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Vasoconstriction</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12089]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Effects are reversible</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>         </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- irreversible</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12090]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Ca</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>lcium</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> \u2013 Supplementation:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12091]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>After 20 weeks 1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5 \u2013 2 g Elemental Calcium/day.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12092]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2 \u2013 3 divided doses until delivery.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12093]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Target population \u2013 High risk for Pre \u2013 Eclampsia, Ca deficiency population.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12094]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Max dose 3000mg/day.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12095]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Ca + Aspirin:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12096]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Can be given simultaneousl</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>y</span></span></div>",
