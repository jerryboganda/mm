      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-13-005\" hidden></div>\n<h2 class=\"mm-heading mm-h2 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24441]\" style=\"background-color: #2F5496; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Times New Roman\", sans-serif; font-size: 16pt'><strong>5</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Times New Roman\", sans-serif; font-size: 16pt'><strong>. P</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Times New Roman\", sans-serif; font-size: 16pt'><strong>ATIENT AND PUBLIC INVOLVEMENT</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Times New Roman\", sans-serif; font-size: 16pt'><strong> </strong></span></h2>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24442]\" style=\"margin-bottom: 5pt; margin-left: 36pt\"><span class=\"mm-run\" style='color: #222222; font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Pts and public can be engaged in a variety of ways</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24443]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Patient advisory and liaison services</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24444]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Quantitative pts surveys (questionnaires)</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24445]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Qualitative pts surveys (depth interview, focus groups)</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24446]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Pts stories and diaries/observational studies</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24447]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Workshops and conferences</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24448]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Consultation with pt representative and group</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24449]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Pts forums, council and panels</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24450]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Pt representative committee and group</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24451]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>Patient advisory liaison services </strong></u></span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>PALS</strong></u></span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong> </strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24452]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Where pts can enroll their complaints</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24453]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Whether they are annoyed, pleased or need inquiry</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24454]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u>PALS statement</u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24455]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Happy: tell us</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24456]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Enquiry: let us help you</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24457]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Un</span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>ha</span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>ppy: let us resolve together</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24458]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>Pts complaints</strong></u></span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24459]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>1.PALS:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24460]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Pts lodges their complaints at local level</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24461]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Majority of complaints are resoled locally</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24462]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>If not satisfied then refer to ombudsman</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24463]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>2.</strong></u></span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'><u><strong>Ombudsman</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24464]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Parliamentary health services</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24465]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'>Undertake independent investigations</span><span class=\"mm-run\" style='font-family: \"Times New Roman\", sans-serif; font-size: 12pt'> to complaints that has not been settled at the local level.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24466]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24467]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24468]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24469]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24470]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24471]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24472]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24473]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24474]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24475]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[24476]\" style=\"margin-bottom: 5pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/