      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-08-036\" hidden></div>\n<h3 class=\"mm-heading mm-h3 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14819]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>3</span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>5</span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>.1. A \u2013 APPENDICITIS</span></h3>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14820]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1/800.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14821]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Commonest cause of acute abd</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>omen</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> in pregnancy.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14822]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>S/S:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14823]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Non \u2013 Classical.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14824]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Rt lower Q pain 75% (non-pregnant 95%).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14825]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Upper Q pain.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14826]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>N/V, anorexia, dysuria</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>. </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14827]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Rebound </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tenderness</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>roving</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> sign).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14828]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abd</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ominal</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> guarding.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14829]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Rectal tenderness.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14830]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fever 39.3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>C.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14831]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tenderness / pain in Mc \u2013 </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Burn</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ey</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>\u2019</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>s</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> point (6cm from anterior</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> sup</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>erior iliac</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> spine).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14832]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>D/D:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14833]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ectopic.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14834]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Threated miscarriage.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14835]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>G.E.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14836]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Musculoskeletal</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> pain.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14837]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pyelonephritis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14838]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>P</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>T</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>E, HELLP.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14839]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abruption.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14840]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Chorioamni</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>oni</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14841]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ovarian thrombophlebitis (post-natal).</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14842]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Investigations:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14843]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Leukocytosis \u2013 Non-specific.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14844]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>CRP \u2013 non-specific.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14845]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Imaging:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14846]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Purpose is:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14847]\" style=\"margin-bottom: 8pt; padding-left: 90pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>To chance of</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> negative appendectomy.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14848]\" style=\"margin-bottom: 8pt; padding-left: 90pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>To reduce delay in surgery.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14849]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>USG:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14850]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>SEN 67 \u2013 100%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14851]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Spec 83 \u2013 96%.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14852]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>MRI:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14853]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sen 86%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14854]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Spec </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>97%.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14855]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Management:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14856]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Perfora</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>ted Appendix:</strong></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14857]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Laparotomy + appendectomy + lavage + ICU Admission + delivery of baby </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>by C/S </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>(delivery improve outcome).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14858]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Acute Appendicitis appendectomy:</strong></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14859]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Incision</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14860]\" style=\"margin-bottom: 8pt; padding-left: 108pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Midline \u2013 when diagnosis is not clear or delivery of.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14861]\" style=\"margin-bottom: 8pt; padding-left: 108pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Transverse on max tenderness area.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14862]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Risks of Appendicitis:</strong></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14863]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fetal loss rate </span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14864]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>simple appendix 1.5%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14865]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>peritonitis = 6%.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14866]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Perforated appendix 36%.</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14867]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Adhesions \u2013 subfertility.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14868]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>PTB \u2013 infected appendix </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>irritates</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> uterus.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14869]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Laparoscopy in all </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"25e93a2cfc3651e9c81c7884\" data-mm-topic-id=\"t-mm-08-036\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 25e93a2cfc3651e9c81c7884\" viewbox=\"0 0 123825 104775\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"c04d42cfe1e566103cb2ae874af8ead74575b62bf90180d5858c5154ee5b977d\"><defs><clippath id=\"clip-912a7528965604ddad75\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 120015 0 L 120015 97790 L 0 97790 Z\"></path></clippath></defs><g data-mm-object-id=\"912a7528965604ddad75\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-912a7528965604ddad75)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/866549440181cb5999a3a2f1bc4156e1e0db1172ad3b89b5e1e2b13d8f0bd057.png\" x=\"0\" y=\"0\" width=\"120015\" height=\"97790\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14870]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Risk of fetal loss but same PTB rate.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14871]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>I/O normal looking appendix =&gt; Remove as it is histological </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>diagnosis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14872]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Chronic appendicitis:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14873]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Walled off appendix, appendicular mass.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14874]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Conservative treatment. [no surgery]</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14875]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Anesthesia management/ Pre \u2013op/ Surgical Management:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14876]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>GA riskier, regional is preferred.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14877]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tocolysis NR (GA has oncolytic effect).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14878]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Steroid</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> @</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 24 \u2013 34 weeks.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14879]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>CTG during</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> late </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"4804c4472578bc9c4dccaca7\" data-mm-topic-id=\"t-mm-08-036\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 4804c4472578bc9c4dccaca7\" viewbox=\"0 0 123825 104775\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"d6f11abe2ca851cda6a9e6d8bfa255e97e2a60135ccbaba07358fb38f18ee274\"><defs><clippath id=\"clip-2b455f8f18dd27463c90\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 120015 0 L 120015 97790 L 0 97790 Z\"></path></clippath></defs><g data-mm-object-id=\"2b455f8f18dd27463c90\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-2b455f8f18dd27463c90)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/866549440181cb5999a3a2f1bc4156e1e0db1172ad3b89b5e1e2b13d8f0bd057.png\" x=\"0\" y=\"0\" width=\"120015\" height=\"97790\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14880]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>FHR auscultation during</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Early </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"be096e6bf97bef96ad4021f1\" data-mm-topic-id=\"t-mm-08-036\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure be096e6bf97bef96ad4021f1\" viewbox=\"0 0 123825 104775\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"7a5e9fe6d48b8d12025aa3c2f4b671ff835d4e8686987d72bad303d99a000340\"><defs><clippath id=\"clip-bd06fa6dcbb6e35eea5e\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 120015 0 L 120015 97790 L 0 97790 Z\"></path></clippath></defs><g data-mm-object-id=\"bd06fa6dcbb6e35eea5e\" transform=\"translate(0 0)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-bd06fa6dcbb6e35eea5e)\"><image href=\"/uploads/content-images/maternal-mind-book/f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605/media/866549440181cb5999a3a2f1bc4156e1e0db1172ad3b89b5e1e2b13d8f0bd057.png\" x=\"0\" y=\"0\" width=\"120015\" height=\"97790\" preserveaspectratio=\"none\"></image></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14881]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Abnormal FHR:</strong></span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"7520b1fa7775880844cd3eef\" data-mm-topic-id=\"t-mm-08-036\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 7520b1fa7775880844cd3eef\" viewbox=\"2219325 285750 76200 742950\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"9bf39c9308b70c4eb49aebd10c6876241b5c77723a43fec938e04a0f40b7c356\"><g data-mm-object-id=\"07a4b57272b0623df0da\" transform=\"translate(2230755 292735)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 A 45719 3809.76427 0 0 1 45719 3809.76427 L 45719 699168.23573 A 45719 3809.76427 0 0 1 0 702978 Z\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\"></path><path d=\"M 0 0 A 45719 3809.76427 0 0 1 45719 3809.76427 L 45719 699168.23573 A 45719 3809.76427 0 0 1 0 702978\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14882]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Correct hypovolemia.</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Not corrected</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14883]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Correct hypotension.</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>with conservative</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14884]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ensure </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>left</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> lateral tilt.</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>treatment =&gt; C/S</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14885]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Oxygenation.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14886]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Analgesia:</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14887]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Opiates safe</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14888]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>NSAIDS up to 32 weeks.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14889]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>VTE prophylaxis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> during admission ace to GTG.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14890]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>A/B given as per protocol</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14891]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Anti D when there is uterine manipulation.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14892]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Minimal uterine &amp; cx manipulation</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> intraoperatively</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>.</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14893]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Simultaneous C/S:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14894]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Perforated appendix/ Maternal sepsis requiring maternal resuscitation.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14895]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&gt; 37 + obs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tetric</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> indication.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[14896]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Not done 