><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>SSRI</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>avoid in pregnancy</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>:</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Paroxetine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, citalopram, Escitalopram</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"734073babcee7b49d794c629\" data-mm-topic-id=\"t-mm-11-013\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 734073babcee7b49d794c629\" viewbox=\"495300 133350 6858000 5705475\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"42f4eeb49fb9f107cbc73b7945900b7d561ff5dc295255969567264385fc7bca\"><defs><clippath id=\"clip-e6c81d5b578295defac2\" clippathunits=\"userSpaceOnUse\"><path d=\"M 0 0 L 6815163 0 L 6815163 5639040 L 0 5639040 Z\"></path></clippath></defs><g data-mm-object-id=\"be22e177f1ea36df4551\" transform=\"translate(503702 140579)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 6846277 0 L 6846277 5691553 L 0 5691553 Z\" fill=\"none\" fill-opacity=\"0\" stroke=\"none\" stroke-opacity=\"0\" stroke-width=\"6350\"></path><g data-mm-text-anchor=\"t\" transform=\"translate(0 45720)\"><g transform=\"scale(12700)\"><text data-mm-wrapped-line=\"0\" x=\"7.2\" y=\"12\" text-anchor=\"start\" xml:space=\"preserve\"></text></g></g><g data-mm-nested-drawing=\"true\"><g data-mm-object-id=\"e6c81d5b578295defac2\" transform=\"translate(91440 45720)\"><g transform=\"translate(0 0)\" clip-path=\"url(#clip-e6c81d5b578295defac2)\"><image href=\"/u