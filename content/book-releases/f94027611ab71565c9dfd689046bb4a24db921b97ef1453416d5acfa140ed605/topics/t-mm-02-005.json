      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-02-005\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2408]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>MANAGEMENT</span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'> OF FEMALE PARTNER:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2409]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2410]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Tubal/uterine factors</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>:</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>(where expertise are present).</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Ovulation disorders</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>WHO Classes</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Class I</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>: </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hypogonadotropic </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hypogonadism</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>increase</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>BMI if &lt;19</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Moderate </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>exercise</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>pulsatile</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>GnRH </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>analogues</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Or</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Gonadotrophins</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>With LH</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> activity</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> to</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Induce </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ovulation.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2411]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2412]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Class II</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hypothalamic pituitary </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ovarian </span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>1</strong></span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup><strong>st</strong></sup></span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> line: clomiphene citrate</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> BMI if &gt;30</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>CC or Met</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>formin</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or Comb</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ination</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Acc to BMI</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>CC:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> - USG monitoring of </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>@ least </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1 cycle</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> to know the ovarian response</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Don\u2019t use for &gt;6 cycles</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>CC failure</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>IVF</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2413]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Uterine:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'>Adhesiolysis via hysteroscopy in case of asherman </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'>syndrome</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Tubal disease</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Mild:</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>=&gt;</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> microsurgery &amp; laparoscopic surgery improves chances of conception.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tubal </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Caut</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>erization</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or can</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ulation in proximal blockade</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>sa</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>lpingography + selective </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>catheter</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ization</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hysteroscopy tubal </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>cannulation</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Salpingectomy before IVF</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> if</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrosalpinx</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2414]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2415]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2416]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2417]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2418]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2419]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2420]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>CC resistance:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Move to 2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> line</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong>2</strong></em></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup><u><em><strong>nd</strong></em></u></sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><em><strong> line:</strong></em></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>ovarian drilling</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>CC + Met</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>formin</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> if not</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> </strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Given before.</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Gonadotrophins</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Routine USG Monitoring</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>To rule out</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>OHSS</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Multiple</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pregnancy.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>PCOS:</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Who are given Gonadotrophins should avoid GnRH Analogues due to risk of OHSS &amp; it does not improve pregnancy rate.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>GH</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> NR.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>hyperprolactinemia:</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> </strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Dopamine agonists.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>letrozole</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> not licensed </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>f</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>or OI in UK.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>CC resistance = no ovulation with cc</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>CC failure = no pregnancy despite ovulation</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2421]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2422]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2423]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2424]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2425]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2426]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2427]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2428]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2429]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2430]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2431]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2432]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2433]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[2434]\">\u00a0</p>",
