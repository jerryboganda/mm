      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-09-005\" hidden></div>\n<h3 class=\"mm-heading mm-h3 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16106]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>1.4. </span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>HERPS IN PREGNANCY + NEONATAL CARE:</span></h3>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16107]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>50% HSV \u2013 1.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16108]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>50% HSV \u2013 2.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16109]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Neonatal Herpes:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16110]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Skin, eye, mouth = 30%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16111]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Local CNS = 60%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16112]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Disseminated = 70%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16113]\" style=\"margin-bottom: 8pt; padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No miscarriage.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16114]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No teratogenicity</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16115]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16116]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16117]\" style=\"text-align: center; margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u><strong>Herpes Suspected \u2013 Refer to GUM PCR for </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u><strong>diagnosis</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u><strong> + contact training.</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16118]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16119]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>P</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> Acquisition in 3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><sup>rd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> (&gt; 28 weeks) Ig \u2013 M +ve</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>St</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>andar</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>d dose treatment + suppressive therapy</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Acyclovir 400mg TDS till delivery</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> for 5 days(435)</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Lidocaine 2%</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> for</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>  </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Paracetamol for pain</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Within 6 weeks\u2019 risk of neonatal infection 41%.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>C/S</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Observe baby</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Routine care</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>[no swabs]</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Recurrent Herpes 1 \u2013 3%.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Treatment with std dose </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>(</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>435</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>)</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> if necessary, otherwise only symptomatic treatment.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Daily suppressive acyclovir from 36 weeks 400 TDS till delivery.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Normal vaginal delivery.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Ulcers Positive</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>           a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>bsent      </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> @ time of delivery</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Observe baby for</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>routine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> 24 hours.</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>care</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Well</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Discharge [no SWAB].</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Advice parents regarding any concern.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>P</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> Herpes in 1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><sup>st</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> /2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'> before 28 weeks.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Treatment with st</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>andar</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>d dose  + suppressive acyclovir from 36 weeks.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>SVD</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16120]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16121]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16122]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16123]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16124]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16125]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16126]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16127]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>&gt; 6weeks??</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><u><strong>SVD:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Inform Neonatologist.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Assess Baby sends swabs:</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 9pt'>Skin</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 9pt'>Oropharynx </span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 9pt'>Conjunctiva</span><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 9pt'>Rectum</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>[SCOR]</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><strong>Well</strong></span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'><strong>Not Well</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- Acyclovir 20mg/kg</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- I/V Acyclovir            TDS till results are</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- LP is needed</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>         available. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>- No LP. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>(lumber puncture)</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16128]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16129]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'><u><strong>Mother refuses:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'>1. I/V acyclovir 5mg/kg</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'> every </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'>8hrs + neonatal acyclovir 20mg/ kg</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'> every</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'> 8 hours</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16130]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16131]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16132]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16133]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16134]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16135]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16136]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16137]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-p