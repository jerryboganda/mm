      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-08-011\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12231]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><u><strong>VWD</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12232]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Incidence : </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>1/ 10,000</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12233]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Most common inherited bleeding disorder.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12234]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Les</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>s symptomatic more common 1/ 1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>000.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12235]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Menorrhagia is hallmark</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12236]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Type I:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12237]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Par</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tial </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Quantitative</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, Autosomal</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>dominant.</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12238]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Variable </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>penetrance</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>/ Expressivity.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12239]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Low VWD</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 0</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3 \u2013 0.5 Iu/ml.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12240]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Severe VWD </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&lt; 0.3 IU/ml </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12241]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Levels increase</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> during pregnancy.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12242]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Manage in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Obs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tetric</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> unit.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12243]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Regional </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>anaesthesia can be given</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12244]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No neonatal testing of co</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>rd blood.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12245]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>DDAVP is effective</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12246]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Type II:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12247]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Qualitative \u2013 generally</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> autosomal</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> dominant except</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> Type</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> N.</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12248]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Types:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12249]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2A</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12250]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2B \u2013 thrombocytopenia.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12251]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2N \u2013 No recessive inheritance</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12252]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2M.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12253]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Type III:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12254]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Absent VWF</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, autosomal </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>recessive inheritance, more in consanguineous</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> relations</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12255]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>PND + genetic testing + counselling.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12256]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Riskier</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12257]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12258]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>DDAVP</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>not effective</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>,</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> factor should be given.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12259]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Crani</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>al USG</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> in Neonates</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12260]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Neonatal Testing of cord blood</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12261]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No regional anaesthesia</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>. </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12262]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No FBS, FSE, </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>vacuum, mid cavity Forceps.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12263]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>M</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>aternal Risks</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> of Type II &amp; III &amp; severe Type I</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12264]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>APH \u2013 10</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>times</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12265]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>P</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> PPH \u2013 15 \u2013 30%.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12266]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>S</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> PPH \u2013 25%.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12267]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Blood Tx = 5</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>times</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12268]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mortality = 10</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>times</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12269]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Neonatal</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> Concerns</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12270]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Type 2, 3 + severe forms of type 1.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12271]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Cord blood testing =</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> Type</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 2,3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>risk of ICH, ECH</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>)</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12272]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Carnival USG = Type 3.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12273]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Short Term Prophylaxis type 3.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12274]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Oral vitamin K 2,3.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12275]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mild VWD testing @</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 6m</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> of age.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12276]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Pre pregnancy + ANC</strong></u></span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12277]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Check</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12278]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Bleeding phenotype.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12279]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Historical </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>diagnosis</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12280]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Response to DDAVP.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12281]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>VWF</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> antigen level + activity + factor VIII </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12282]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>@ Book</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ing 3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>rd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, prior to invasive procedure.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12283]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Type I + normal VWF =&gt; std Management in pregnancy in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>liaison</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> with hemophilia center (std obs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tetric</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> care).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12284]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Type 2,3 severe I =&gt; specialist center in high risk obs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tetric</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (in center with expertise MDT).</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12285]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tar</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>get Factor VIII + VWF </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Risto ce</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tin</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> co</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>f</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>acto</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>r activity 0.5IU/ml.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12286]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Hemostatic Support:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12287]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>DDAVP:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12288]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avoid in 2B, III, with baseline level &lt; 0.15.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12289]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2B \u2013 Thrombocytopenia with DDAVP.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12290]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>DDAVP    </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>VWF  2 \u2013 </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5-fold</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12291]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>In responders: 0.3ug/k</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>g of DDAVP.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12292]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Plasma derived VWF </strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>concentrate </strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>replacement:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12293]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Screening </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>for transfusion related</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> transmitted infections.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12294]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Vaccination He</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>p</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> A &amp; B.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12295]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Contain VIII and VWF</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12296]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Powder form</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> has two types</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12297]\"><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 14pt'>High Purity.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12298]\"><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 14pt'>Intermediate purity.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12299]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Slow bolus I/V.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12300]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>VWF ag/ VWF: RCO consideration before VWF concentrate replacement as amount of VIII varies between different preparations.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12301]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>IPC + Ana</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>e</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>sthesia:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12302]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>M</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>O</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>D </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>depends </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>on obs</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tetric</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> indicators. </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12303]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Measure levels of VWF near delivery Pre and Post treatment, after delivery or i</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>f</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> labour is prolonged.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12304]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ECV, mid cavity</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>forceps</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>,</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>vacuum</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, FSE, FBS, C/I in type 2,3.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12305]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Outlet</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or low forceps</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> can be used.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12306]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Prophylaxis for PPH:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12307]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tra</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>nex</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>amic</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> acid 1g I/V in low</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> or </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>normal VWF: RCO levels,</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12308]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Desmopressin</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> = close to delivery, can be given along or in combination with tranexamic acid.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12309]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Plt transfusion in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>B VWD</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12310]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>VWF replacement in 2B</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12311]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12312]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12313]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12314]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Regional Anaesthesia:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12315]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Discuss Anaesthesia options with women and senior </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Anaesthetist</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12316]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Type I</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12317]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Regional anaesthesia is safe in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Type I with normal level &gt; 0.5.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12318]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Type II</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12319]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Can be given if &gt; 0.5IU/ml.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12320]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hemostatic defect corrected.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12321]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Type III:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12322]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Avoid.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12323]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>I/M injection </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>can be given </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>where VWF activity and VIII levels &gt; 0.5 IU/ml.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12324]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>PNC:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12325]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Maintain VWF activity and factor VIII</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12326]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3 days </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>SVD.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12327]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5 days </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>C/S.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12328]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tranexamic </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>acid </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>g 3 \u2013 4times/ day</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>,</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 7 \u2013 14days</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12329]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sometimes 2 \u2013 3 weeks or more.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12330]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Thromboprophylaxis after correction of VWF RCO/VIII.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12331]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>VWF concentrate required in type 3 for 3 weeks after delivery.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12332]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Average time for PPH 10 \u2013 20 days.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12333]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>COCP in P/P period    es VWF production.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12334]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Offer COCP if no other contraindication</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12335]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12336]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12337]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12338]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12339]\">\u00a0</p>",
      "content_sha256": "7691b46d1a00c4093934bb8d2be2021fa87f308ac6e5e676ee920df9afac0cb2",
      "block_type": "document_html"
    }
  ]
}