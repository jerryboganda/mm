      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-10-014\" hidden></div>\n<div class=\"mm-heading mm-h3 mm-header-banner mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20716]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt; padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">3.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>WOMAN ON LONG TERM SYSTEMIC STEROIDS</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20717]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Stress Dose Steroids:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20718]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Women with adrenal insufficiency </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20719]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Taking long term steroid </span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20720]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Prednisolone 5mg daily or more for &gt; 3 months.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20721]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20722]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20723]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Continue regular oral steroid.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20724]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Give stress steroids</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20725]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>1. </strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>In Labo</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>u</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>r:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20726]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrocortisone 50mg I/V or I/m</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20727]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Every 6 hours till delivery</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20728]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>And 6 hours after birth.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20729]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>2. In planned C/S:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20730]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>100mg Hydrocortisone I/V before induction of anesthesia</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20731]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>50mg 6 hours after birth.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20732]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>3. In Emergency C/S:</strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20733]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>50mg hydrocortisone I/V (if women have received 50mg in labor).</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20734]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>50mg 6 hours after birth.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20735]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No need of stress dose in women who are taking topical or inhalational steroids.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20736]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>",
