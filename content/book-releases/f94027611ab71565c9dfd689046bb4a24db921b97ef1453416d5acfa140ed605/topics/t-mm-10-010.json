  "topic_id": "t-mm-10-010",
  "book_id": "book-mm-10",
  "title": "2.\tNEONATAL CARE AND RESUSCITATION:",
  "source_sha256": "f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605",
  "block_count": 1,
  "blocks": [
    {
      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-10-010\" hidden></div>\n<div class=\"mm-heading mm-h2 mm-header-banner mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20421]\" style=\"background-color: #2F5496; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">2.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>NEONATAL CARE AND RESUSCITATION:</strong></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20422]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><em><strong>Care of the new born Baby:</strong></em></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20423]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Record APGR score routinely @ 1 min and 5 min.</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20424]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20425]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>For central oxygenation look inside the mouth at mucous membranes and tongue</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20426]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>For peripheral oxygenation look at the color of the nail bed.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20427]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Record time from birth to the onset of regular </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>breathing pattern</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20428]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Don\u2019t take paired cord blood routinely for blood gas analysis.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20429]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Send paired cord blood sample if baby is born in poor condition</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20430]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Encourage skin to skin contact of baby with mother or her birth companion.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20431]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Keep baby warm and dry</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20432]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Avoid airway blockage while skin to skin contact by maintaining proper head position.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20433]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Initiate breast feeding as soon as possible.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20434]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Record head circumference and birth weight after 1-hour skin to skin contact and plot on centile chart.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20435]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Initial examination to detect minor physical abnormality.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20436]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>SSRI and SNRI</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong> pose</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong> risk of persistent pulmonary hypertension of newborn and also cause neonatal withdrawal symptoms. Therefore, take extra care of those women who </strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>are</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong> taking SSRI &amp; SNR</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20437]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20438]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20439]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20440]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20441]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20442]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20443]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20444]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20445]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20446]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20447]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20448]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20449]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20450]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20451]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20452]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20453]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20454]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20455]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20456]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20457]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20458]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20459]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20460]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20461]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20462]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20463]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20464]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20465]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20466]\" style=\"margin-bottom: 8pt; margin-left: 18pt\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20467]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Neonatal Resuscitation</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong> Algorythm</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>:</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20468]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20469]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20470]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20471]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20472]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 13pt'><u><strong>Care of baby with meconium:</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20473]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Don\u2019t do suction of airway before birth of shoulders and trunk.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20474]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Don\u2019t suction baby\u2019s upper airways if baby has normal respiration, Heart rate and tone.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20475]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Don\u2019t intubate if baby has normal respiration, Heart rate and tone.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20476]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>If HR, Respiration and tone Abnormal</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20477]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20478]\" style=\"margin-bottom: 8pt; margin-left: 36pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Follow guidelines on Neonatal Resuscitation.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20479]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Observation of baby with Meconium:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20480]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20481]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Significant Meconium</strong></em></span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Non-</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Significant</strong></em></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong> </strong></em></span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Meconium</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20482]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Closely observe in</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20483]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Unit where neonatologist</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>Observing</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 10pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 11pt'>@ 1 hour &amp;</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20484]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Is present</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2 hours.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20485]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- Perform observations @</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- @ all birth settings</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20486]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1 hour and</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20487]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2 hours</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20488]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Then 2 hourly till 12 hours</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20489]\" style=\"margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20490]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Assessment by neonatologist if:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20491]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>RR &gt; 60min</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20492]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Presence of grunting</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20493]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>HR &lt; 100/min or &gt; 160/min</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20494]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Capillary refill time &gt; 3 sec</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20495]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Body temp of 38</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup><u><strong>0</strong></u></sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>C or above, or 37.5</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup><u><strong>0</strong></u></sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>C on 2 readings 15 \u2013 30min apart.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20496]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>SPo</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sub><u><strong>2</strong></u></sub></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> &lt; 95%.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20497]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Central cyanosis</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20498]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20499]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20500]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20501]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u21e8</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Care of baby born to woman with PROM &gt; 24 hours:</strong></em></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20502]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Temperature</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20503]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>HR</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20504]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>RR</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20505]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Respiratory grunting</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20506]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Subcostal recession</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20507]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Central cyanosis</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20508]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Skin perfusion</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> by</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> capillary refill</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> time</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20509]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Floppiness</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20510]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Concerns regarding general wellbeing and feeding.</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20511]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ay concern arises in above observations, call neonatologists for observation.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20512]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No need of antibiotics routinely</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20513]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>No need of antibiotics either woman or baby if no signs of infections even if PROM &gt; 24 hours.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20514]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Consider Antibiotics to mother or baby if there is evidence of infection.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20515]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Advise wom</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>n to inform healthcare professionals immediately if she has any concern regarding baby\u2019s wellness during 5 days\u2019 a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>n</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>d particularly 12 hours after birth.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20516]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Referral to neonatal care specialist immediately:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20517]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Baby with symptoms/ signs of sepsis</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20518]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Baby born to mother who has evidence of chorioamni</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>oni</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>tis.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20519]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20520]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20521]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20522]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20523]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20524]\" style=\"margin-bottom: 8pt; margin-left: 36pt\">\u00a0</p>",
