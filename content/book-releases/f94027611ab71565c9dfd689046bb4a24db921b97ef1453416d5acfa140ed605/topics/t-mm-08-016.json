    {
      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-08-016\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12634]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>DERMATOLOGICAL CONDITIONS OF PREGNANCY</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12635]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Melasma 75%.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12636]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Spider nevi</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> \u2013 66% </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Caucasian</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>, 11% black.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12637]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Pruritus-</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 18% with 80% recurrence.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12638]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Symmetrical lesion =&gt; endogenous cause.</span></p>\n<div class=\"mm-table-scroll\" role=\"region\" tabindex=\"0\"><table class=\"mm-table\" style=\"border-collapse:collapse;margin-left:0pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;\"><colgroup><col style=\"width:86.05pt;\"><col style=\"width:88.15pt;\"><col style=\"width:87.9pt;\"><col style=\"width:83.3pt;\"><col style=\"width:109.25pt;\"><col style=\"width:84.85pt;\"></colgroup><tbody><tr><td style=\"white-space:pre-wrap;width:89.9pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Dermatosis of  pregnancy</p></td><td style=\"white-space:pre-wrap;width:89.9pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Affected area</p></td><td style=\"white-space:pre-wrap;width:89.9pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Risk factors</p></td><td style=\"white-space:pre-wrap;width:89.9pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Recurrence</p></td><td style=\"white-space:pre-wrap;width:89.95pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Management</p></td><td style=\"white-space:pre-wrap;width:89.95pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Pregnancy outcome</p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">IHCP 0.7%</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Scalp Anus, Vulva abdominal skin.</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">*Ethnicity: more in India,</p><p style=\"margin:0;margin-bottom:8pt;\">Pakistan.</p><p style=\"margin:0;margin-bottom:8pt;\">*Previous IHCP</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">60 \u2013 70%</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">* Urso</p><p style=\"margin:0;margin-bottom:8pt;\">* Topical emollients.</p><p style=\"margin:0;margin-bottom:8pt;\">* Sedating anti histamine.</p><p style=\"margin:0;margin-bottom:8pt;\">* Water soluble vitamin K</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Risk of:</p><p style=\"margin:0;margin-bottom:8pt;\">* IUD</p><p style=\"margin:0;margin-bottom:8pt;\">* Meconium</p><p style=\"margin:0;margin-bottom:8pt;\">* PPH.</p><p style=\"margin:0;margin-bottom:8pt;\">* Fetal distress.</p><p style=\"margin:0;margin-bottom:8pt;\">* C/S prematurity.</p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Atopic eruption of pregnancy:</p><p style=\"margin:0;margin-bottom:8pt;\">* Prurigo gestationis.</p><p style=\"margin:0;margin-bottom:8pt;\">* Prurigo Folliculitis.</p><p style=\"margin:0;margin-bottom:8pt;\">* Eczema of Pregnancy.</p><p style=\"margin:0;margin-bottom:8pt;\">* Nurse early onset Prurigo.</p><p style=\"margin:0;margin-bottom:8pt;\">Risk is 1/300</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Erythematous/ excoriated </p><p style=\"margin:0;margin-bottom:8pt;\">nodules.</p><p style=\"margin:0;margin-bottom:8pt;\">Papules on</p><p style=\"margin:0;margin-bottom:8pt;\">Face, Neck, Chest</p><p style=\"margin:0;margin-bottom:8pt;\">Extensor surfaces.</p><p style=\"margin:0;margin-bottom:8pt;\">* Immune mediated.</p><p style=\"margin:0;margin-bottom:8pt;\">* Clinical diagnosis.</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Family History</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Limited data</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">* Topical emollients.</p><p style=\"margin:0;margin-bottom:8pt;\">* Anti pruritus.</p><p style=\"margin:0;margin-bottom:8pt;\">* Topical steroids</p><p style=\"margin:0;margin-bottom:8pt;\">* Anti Histamine, UV light.</p><p style=\"margin:0;margin-bottom:8pt;\">* 1% Menthol.</p><p style=\"margin:0;margin-bottom:8pt;\">* Benzoyl per oxide.</p><p style=\"margin:0;margin-bottom:8pt;\">* Erythromycin,</p><p style=\"margin:0;margin-bottom:8pt;\">* Zinc.</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">No Adverse effects.</p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">* Polymorphic eruption of pregnancy PEP </p><p style=\"margin:0;margin-bottom:8pt;\">* 1/160 \u20131/300.</p><p style=\"margin:0;margin-bottom:8pt;\">*Pruritic, urticarial papules/ plaques of pregnancy.</p><p style=\"margin:0;margin-bottom:8pt;\">* Toxic erythema.</p><p style=\"margin:0;margin-bottom:8pt;\">* Nurse late onset.</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Periumbilical sparing + sparing of palms, soles and face</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">PG, twins over distention.</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Rarely occur</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">* Topical steroids (1st line)</p><p style=\"margin:0;margin-bottom:8pt;\">* Emollients.</p><p style=\"margin:0;margin-bottom:8pt;\">* Oral steroids.</p><p style=\"margin:0;margin-bottom:8pt;\">* Anti Histamine.</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">No adverse effect.</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">* Pemphigoid Gestationis </p><p style=\"margin:0;margin-bottom:8pt;\">* 1/700-1/50\u2019000.</p><p style=\"margin:0;margin-bottom:8pt;\">* Herpes Gestationis.</p><p style=\"margin:0;margin-bottom:8pt;\">* Bullous pemphigoid.</p><p style=\"margin:0;margin-bottom:8pt;\">* Gestationis</p><p style=\"margin:0;margin-bottom:8pt;\">Pemphigoids.</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">* Bullous eruption.</p><p style=\"margin:0;margin-bottom:8pt;\">* Appears around umbilicus unlike PEP.</p><p style=\"margin:0;margin-bottom:8pt;\">* Mucosal sparing.</p><p style=\"margin:0;margin-bottom:8pt;\">* All over the body.</p><p style=\"margin:0;margin-bottom:8pt;\">* Biopsy necessary.</p><p style=\"margin:0;margin-bottom:8pt;\">* Two samples:</p><p style=\"margin:0;margin-bottom:8pt;\">1. Biopsy.</p><p style=\"margin:0;margin-bottom:8pt;\">2. Immune studies.</p><p style=\"margin:0;margin-bottom:8pt;\">* Flare @ time of delivery</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Immunological HLA \u2013 DR3, DR4.</p></td><td style=\"white-space:pre-wrap;width:89.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">* Recurrence with earlier onset and increasing severity.</p><p style=\"margin:0;margin-bottom:8pt;\">* Recurrence with OCP and periods.</p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">* Topical/ Oral steroid.</p><p style=\"margin:0;margin-bottom:8pt;\">* Anti Histamines</p><p style=\"margin:0;margin-bottom:8pt;\">* Antibiotics.</p><p style=\"margin:0;margin-bottom:8pt;\">* Immunosuppressive drugs.</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:89.95pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">* IUGR.</p><p style=\"margin:0;margin-bottom:8pt;\">* Pre \u2013 Term.</p><p style=\"margin:0;margin-bottom:8pt;\">* self-limiting.</p><p style=\"margin:0;margin-bottom:8pt;\">* Skin lesion in Neonates.</p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12639]\"><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>Table </em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>33</em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>. </em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>DERMATOLOGICAL CONDITIONS OF PREGNANCY</em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[12640]\">\u00a0</p>",
      "content_sha256": "1b5917513c3637d440eb48be16e48012387be654c38ee66118968c7d6bfb4eda",
