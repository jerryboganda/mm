/p><p style=\"margin:0;margin-bottom:8pt;\">Not required</p></td><td style=\"white-space:pre-wrap;width:52.45pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr><tr><td style=\"white-space:pre-wrap;width:79pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Syphilis</p></td><td style=\"white-space:pre-wrap;width:85.05pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td colspan=\"2\" style=\"white-space:pre-wrap;width:120.5pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Painless ulcers </p><p style=\"margin:0;margin-bottom:8pt;\">Painless lymphadenopathy</p></td><td style=\"white-space:pre-wrap;width:70.85pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:78pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td><