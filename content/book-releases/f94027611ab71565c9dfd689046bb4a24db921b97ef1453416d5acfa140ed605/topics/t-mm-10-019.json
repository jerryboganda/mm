trong> </strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>treatment</strong></span></p></td><td style=\"white-space:pre-wrap;width:91.25pt;background-color:#B4C6E7;border-top:0.75pt solid #000000;border-right:0.75pt solid #000000;border-bottom:0.75pt solid #000000;border-left:0.75pt solid #000000;padding-right:0pt;padding-left:0pt;\"><p style=\"margin:0;text-align:center;padding-left:0.4pt;padding-right:1.5pt;margin-bottom:0pt;\"><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>Sepsis</strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong> </strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>or</strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong> </strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>suspected sepsis \u2013 on </strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>antibiotic</strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong> </strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>treatment</strong></span></p></td><td style=\"white-space:pre-wrap;width:138.15pt;background-color:#B4C6E7;border-top:0.75pt solid #000000;border-right:0.75pt solid #000000;border-bottom:0.75pt solid #000000;border-left:0.75pt solid #000000;padding-right:0pt;padding-left:0pt;\"><p style=\"margin:0;text-align:center;padding-left:0.4pt;margin-top:10.45pt;margin-bottom:0pt;\"><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>Intrapartum</strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong> </strong></span><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'><strong>haemorrhage</strong></span></p></td></tr><tr data-mm-row-height-twips=\"648\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:100.65pt;border-top:0.75pt solid #000000;border-right:0.75pt solid #000000;border-bottom:0.75pt solid #000000;border-left:0.75pt solid #000000;padding-right:0pt;padding-left:0pt;\"><p style=\"margin:0;margin-top:8.6pt;margin-bottom:0pt;\"></p><p style=\"margin:0;padding-left:4.1pt;margin-bottom:0pt;\"><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'>Pulse</span></p></td><td style=\"white-space:pre-wrap;width:82.55pt;border-top:0.75pt solid #000000;border-right:0.75pt solid #000000;border-bottom:0.75pt solid #000000;border-left:0.75pt solid #000000;padding-right:0pt;padding-left:0pt;\"><p style=\"margin:0;margin-top:8.6pt;margin-bottom:0pt;\"></p><p style=\"margin:0;padding-left:4.1pt;margin-bottom:0pt;\"><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'>Hourly</span></p></td><td style=\"white-space:pre-wrap;width:106.2pt;border-top:0.75pt solid #000000;border-right:0.75pt solid #000000;border-bottom:0.75pt solid #000000;border-left:0.75pt solid #000000;padding-right:0pt;padding-left:0pt;\"><p style=\"margin:0;margin-top:8.6pt;margin-bottom:0pt;\"></p><p style=\"margin:0;padding-left:4.15pt;margin-bottom:0pt;\"><span class=\"mm-run\" style='color:#282828;font-family:\"Tahoma\", sans-serif;font-size:12pt'>Hourly</span></p></td><td style=\"white-space:pre-wrap;width:91.25pt;border-top:0.75pt solid #000000;border-right:0.75pt solid #000000;border-bottom:0.75pt solid #000000;border-left:0.75pt solid #000000;padding-right:0pt;padding-left:0pt;\"><p style=\"margin:0;padding-left:4.15pt;padding-right:1.5pt;margin-top:5.1pt;mar