      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-01-018\" hidden></div>\n<h2 class=\"mm-heading mm-h2 mm-header-banner\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1426]\" style=\"background-color: #2F5496; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>1</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>7</strong></span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>. OUTFLOW TRACK DISORDERS OF VAGINA:</strong></span></h2>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1427]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">1.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><em><strong>Imperforate Hymen:</strong></em></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1428]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Bluish Bulge </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1429]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Treated by General </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>gyn</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>a</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>ecologists</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> @ </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>secondary</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> care level.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1430]\" style=\"margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><em><strong>Treatment: </strong></em></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1431]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Cruciate incision, margins either timed or left as it is.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1432]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Complete drainage @ 3-5 days.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1433]\">\u00a0</p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1434]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">2.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><em><strong>Transverse vaginal septum</strong></em></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><em> </em></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>(1/30,000 \u2013 1/50,000)</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1435]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><u><strong>Upper</strong></u></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><u><strong> (</strong></u></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><u><strong>A)</strong></u></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>most</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> common 46%</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1436]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1437]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1438]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Treatment:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1439]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Resection +</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>end to end</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>a</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>nastomosis </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>followed by</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> insertion of </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>m</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>o</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>u</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>lds</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> for 3-6</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>months</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> (</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>risk of damage to bladder </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>and rectum</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>)</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1440]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Risk of stenosis if </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>m</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>oulds</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> are</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> not used or sexually inactive</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1441]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Pregnancy </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>rate </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>only</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>20% following t/m</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> due to tubal damage that</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> has been </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>occurred</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> by hematosalpinx </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>and e</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>ndometriosis d/t Backflow of b</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>lood</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1442]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>c-section is recommended</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1443]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><u><strong>Middle</strong></u></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><u><strong> (B)</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1444]\" style=\"margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>30-40%</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> of transverse septum</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1445]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Pregnancy rate 40%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1446]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>c/s is recommended</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1447]\" style=\"padding-left: 54pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2192</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Lower</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> (C)</strong></u></span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1448]\" style=\"margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong> </strong></u></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>15-20%</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> of septum</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1449]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Pregnancy rate 100%</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1450]\" style=\"padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Pinkish bulge </span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1451]\" style=\"margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>t/m: </strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1452]\" style=\"padding-left: 90pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Resection + Anastomosis + Moulds for 10days</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1453]\" style=\"padding-left: 90pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Normal delivery is recommended</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1454]\" style=\"margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>All</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> the</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> vaginal septa are managed @ tertiary care level</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1455]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><u><strong>Longitudinal Vaginal Septum:</strong></u></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1456]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Longitudinal fusion defects.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1457]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Can b</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>e</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>partial or complete</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1458]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Can be high or low</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1459]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>Presentation:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1460]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>abdominal pain </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1461]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Worsening dysmenorrhea</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1462]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Menstruation can be present \u2013 from communicating hemi</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>-</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>vaginum. </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1463]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Haematocolpus + hematometra \u2013 from closed side</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1464]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>Uterus Didelp</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'>hys</span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> =&gt; obstetric complications.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1465]\"><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'><strong>t/m:</strong></span><span class=\"mm-run\" style='font-family: \"Aptos\", sans-serif; font-size: 12pt'> Excision</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1466]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1467]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[1468]\" style=\"margin-bottom: 8pt\">\u00a0</p>",
