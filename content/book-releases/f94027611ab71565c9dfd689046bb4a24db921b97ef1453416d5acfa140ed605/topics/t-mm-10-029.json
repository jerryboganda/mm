      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-10-029\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21364]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'>5. </span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'>E</span><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'>XTERNAL CEPHALIC VERSION:ECV</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21365]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- </span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in multigravida done @</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>37 weeks</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21366]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>- </span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Primi</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>gravida @</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 36 weeks</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21367]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>-</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>increased </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Interval between ECV and birth \u2013    chances of C/S</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21368]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>-</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>9% patient decline ECV</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21369]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Successful \u2013 50%:</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21370]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Primi \u2013 40%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21371]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Multi \u2013 60%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21372]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reversion to breach after ECV </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>= 3</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>%</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21373]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>e</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>d risk of C/S due to obstructed labour and fetal distress in ECV pregnancies and    risk of instrumental birth.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21374]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Tocolysis</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> with </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Betamimetics</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (0.25mg Terbutaline) or 250ug salbutamol in 25ml saline I/V x slow</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ly</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21375]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21376]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21377]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Not effective in </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>\u03b2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> blocker us</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ers</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21378]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>(no role of </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>nifedipine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> &amp; atosiban)</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21379]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Indication of tocolysis:</strong></u></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21380]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1. Routinely</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21381]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2. Tense abdomen</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21382]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Unsuccessful ECV without tocolysis.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21383]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Prophylactic anti \u2013 D </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>in</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> D</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>-ve </sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>women.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21384]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Regional/ </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Neuraxial</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>anaesthesia</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> not recommended</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>routinely</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>,</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> used in repeat attempt or when women don\u2019t tolerate</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21385]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Unstable lie:</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> ECV + stabilizing induction</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21386]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Contraindication</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> of ECV</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21387]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reasons for C/S</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21388]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Previa</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21389]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Distress</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21390]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Multiple pregnancy</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21391]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abruption</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21392]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Severe PE</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21393]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abnormal Doppler</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21394]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Bleeding &lt; 1 week</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21395]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>PROM</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21396]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Mother declines</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21397]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Myomectomy</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21398]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Electronic fetal monitoring is recommended after ECV</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21399]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Testing for </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fetomaternal</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> haemorrhage is recommended</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21400]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Up to 4 attempts in 10 min</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21401]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Caution:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21402]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Previous C/S</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21403]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Polyhydramnios</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21404]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Oligohydramnios</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21405]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>HTN</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21406]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>No ECV once Contraction Started:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21407]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Except twins</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21408]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ECV=</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>nd</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> twin + intact membrane</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21409]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>IPV = twin + Ruptured membrane</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21410]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Pre requisites</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong> of ECV</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21411]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Keep in hand USG, </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>C</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>EFM, OT, An</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>esthesia</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21412]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Transient Br</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>a</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>dy</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>cardia</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> up to 3 min </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>is normal</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21413]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>&gt; 6 min \u2013 cat</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> C/S</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21414]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abnormal persistent CTG</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21415]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Abd</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ominal</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> pain</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>urgent </span><span class=\"mm-run\" style='color: ##2F5496; font-family: \"Calibri\", sans-serif; font-size: 11pt'>delivery</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21416]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Unexplained Bleeding</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21417]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Risk of </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>emergency C/S</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> \u2013 0.5</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>%</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>,</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> 1/200</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21418]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>90% due to vaginal bleeding and fetal distress.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21419]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>M</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>oxibustions \u2013 Chinese </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Medicine    </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> fetal activity</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21420]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><em><strong>Consider:</strong></em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21421]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>@ 33 \u2013 35 weeks for 2 weeks </span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21422]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>43 % success @ 32 weeks.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21423]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Postural management \u2013 no evidence.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[21424]\">\u00a0</p>",
