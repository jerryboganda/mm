      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-05-002\" hidden></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6286]\"><span class=\"mm-run\" style='color: ##FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 16pt'><strong>GENITAL INFECTIONS AND THEIR MANAGEMENTS:</strong></span></p>\n<div class=\"mm-table-scroll mm-table-floating-reflow\" role=\"region\" tabindex=\"0\" data-mm-tblp-left-from-text=\"180\" data-mm-tblp-right-from-text=\"180\" data-mm-tblp-horz-anchor=\"margin\" data-mm-tblp-y=\"652\" style=\"clear:both;margin-left:9pt;margin-right:9pt;\"><table class=\"mm-table\" style=\"border-collapse:collapse;margin-left:0pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;\"><colgroup><col style=\"width:56.55pt;\"><col style=\"width:60.85pt;\"><col style=\"width:61.9pt;\"><col style=\"width:65.45pt;\"><col style=\"width:54.55pt;\"><col style=\"width:61.7pt;\"><col style=\"width:63.3pt;\"><col style=\"width:61.65pt;\"><col style=\"width:53.55pt;\"></colgroup><tbody><tr><td style=\"white-space:pre-wrap;width:63.55pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Infection</p></td><td style=\"white-space:pre-wrap;width:53.6pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">%ages</p></td><td style=\"white-space:pre-wrap;width:61.3pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Diagnosis</p></td><td style=\"white-space:pre-wrap;width:65.3pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">T/m</p></td><td style=\"white-space:pre-wrap;width:54.4pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Alternative</p></td><td style=\"white-space:pre-wrap;width:65.65pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Recurrent</p></td><td style=\"white-space:pre-wrap;width:63.15pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">TOC</p></td><td style=\"white-space:pre-wrap;width:61.5pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Partner screening</p></td><td style=\"white-space:pre-wrap;width:51.05pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Special note</p></td></tr><tr><td style=\"white-space:pre-wrap;width:63.55pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Bacterial vaginosis:</p><p style=\"margin:0;margin-bottom:8pt;\">- Common cause of discharge</p><p style=\"margin:0;margin-bottom:8pt;\">- 20-40 years of age</p><p style=\"margin:0;margin-bottom:8pt;\">- fishy odor after intercourse because semen is alkaline.</p></td><td style=\"white-space:pre-wrap;width:53.6pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">5-50%</p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">TOP 30%</p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Pregnancy 12%</p></td><td style=\"white-space:pre-wrap;width:61.3pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Hay Ison </p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Amsel\u2019s</p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">G staining</p></td><td style=\"white-space:pre-wrap;width:65.3pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*metronidazole 400mg, B.D, 5-7days, P/O  or 0.75% IV, 5day</p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">* clindamycin= 2% P/V for 7D</p></td><td style=\"white-space:pre-wrap;width:54.4pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Tinidazole 2g</p><p style=\"margin:0;margin-bottom:8pt;\">OR</p><p style=\"margin:0;margin-bottom:8pt;\">Clinda 30mg P/O x 7days</p></td><td style=\"white-space:pre-wrap;width:65.65pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Metronidazole 0.75 I/V x OD for 16D</p></td><td style=\"white-space:pre-wrap;width:63.15pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Not recommended</p></td><td style=\"white-space:pre-wrap;width:61.5pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Not recommended</p></td><td style=\"white-space:pre-wrap;width:51.05pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*HIV \u2013 same t/m</p><p style=\"margin:0;margin-bottom:8pt;\">*TOP \u2013 same t/m</p><p style=\"margin:0;margin-bottom:8pt;\">*Pregnancy \u2013 I/V</p><p style=\"margin:0;margin-bottom:8pt;\">*Lactation \u2013 I/V</p><p style=\"margin:0;margin-bottom:8pt;\">Avoid oral</p></td></tr><tr><td style=\"white-space:pre-wrap;width:63.55pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Trichomonas</p><p style=\"margin:0;margin-bottom:8pt;\">*Sexually transmitted </p><p style=\"margin:0;margin-bottom:8pt;\">*frothy discharge 20-40yrs of age</p></td><td style=\"white-space:pre-wrap;width:53.6pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Asymptomatic 10-15%</p><p style=\"margin:0;margin-bottom:8pt;\">- Discharge 70%</p><p style=\"margin:0;margin-bottom:8pt;\">- Frothy 30%</p><p style=\"margin:0;margin-bottom:8pt;\">- Strawberry cervix 2%</p><p style=\"margin:0;margin-bottom:8pt;\">- urethral dx 20%</p></td><td style=\"white-space:pre-wrap;width:61.3pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Microscopy \u2013 initial HVS, VVS</p><p style=\"margin:0;margin-bottom:8pt;\">Culture high sensitivity</p><p style=\"margin:0;margin-bottom:8pt;\">NAAT gold std </p><p style=\"margin:0;margin-bottom:8pt;\">- VVS</p><p style=\"margin:0;margin-bottom:8pt;\">- HVS</p><p style=\"margin:0;margin-bottom:8pt;\">- Urine samples</p></td><td style=\"white-space:pre-wrap;width:65.3pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Metronidazole</p><p style=\"margin:0;margin-bottom:8pt;\">400mg BD 5-7days</p><p style=\"margin:0;margin-bottom:8pt;\">OR</p><p style=\"margin:0;margin-bottom:8pt;\">2g Stat P/O or P/R</p></td><td style=\"white-space:pre-wrap;width:54.4pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Tinidazole 2g stat</p></td><td style=\"white-space:pre-wrap;width:65.65pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Tinidazole</p><p style=\"margin:0;margin-bottom:8pt;\">- expensive</p><p style=\"margin:0;margin-bottom:8pt;\">- Long t/2</p><p style=\"margin:0;margin-bottom:8pt;\">- Remain in tissues</p><p style=\"margin:0;margin-bottom:8pt;\">- more tissue penetration</p><p style=\"margin:0;margin-bottom:8pt;\">Non Responders</p><p style=\"margin:0;margin-bottom:8pt;\">- repeat regimen</p><p style=\"margin:0;margin-bottom:8pt;\">- High dose</p><p style=\"margin:0;margin-bottom:8pt;\">- Metronidazole 2g 0D for</p><p style=\"margin:0;margin-bottom:8pt;\">5 \u2013 7D or 800TDS 7D</p><p style=\"margin:0;margin-bottom:8pt;\">- Tinidazole 1g TDS 14D, 2G B.D 14days</p></td><td style=\"white-space:pre-wrap;width:63.15pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Recommended If </p><p style=\"margin:0;margin-bottom:8pt;\">- symptoms after t/m or</p><p style=\"margin:0;margin-bottom:8pt;\">- Recurrence.</p></td><td style=\"white-space:pre-wrap;width:61.5pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Any partner within 4weeks tested for STI.</p></td><td style=\"white-space:pre-wrap;width:51.05pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">HIV: B.D regimen for 7days</p><p style=\"margin:0;margin-bottom:8pt;\">2g dose not effective</p><p style=\"margin:0;margin-bottom:8pt;\">Pregnancy \u2013 I/V</p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"ee148b917be0c349b5b49f2e\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure ee148b917be0c349b5b49f2e\" viewbox=\"762000 209550 219075 152400\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"9b287d3a5e5b93454c241dc3d8c6df2b7a6c96ea90cc313fb523f93b1e13615c\"><g data-mm-object-id=\"4ab62a30d6f755012d3d\" transform=\"translate(795201 236583)\"><g transform=\"translate(0 0)\"><path d=\"M 0 87086 L 68035.5 0 L 136071 87086 Z\" fill=\"#4472C4\" fill-opacity=\"1\" stroke=\"#223962\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure>Tind C/I in 1st    </p><p style=\"margin:0;margin-bottom:8pt;\">Lactation 12 weeks</p><p style=\"margin:0;margin-bottom:8pt;\">Avoid lactation</p></td></tr><tr data-mm-row-height-twips=\"2250\" data-mm-row-height-rule=\"auto\"><td rowspan=\"2\" style=\"white-space:pre-wrap;width:63.55pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">VVC</p><p style=\"margin:0;margin-bottom:8pt;\">- 20-40yrs</p><p style=\"margin:0;margin-bottom:8pt;\">Low immunity</p><p style=\"margin:0;margin-bottom:8pt;\">=&gt;vulval + under Breast = candiasis</p><p style=\"margin:0;margin-bottom:8pt;\">=&gt;vulval + intra Breast pargets</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td rowspan=\"2\" style=\"white-space:pre-wrap;width:53.6pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">90-90% candida Albicans</p><p style=\"margin:0;margin-bottom:8pt;\">*75% women @ least single episode</p><p style=\"margin:0;margin-bottom:8pt;\">*45%@ least (2) episode</p><p style=\"margin:0;margin-bottom:8pt;\">20% asymptomatic with colonization</p><p style=\"margin:0;margin-bottom:8pt;\">(absence of neutrophils on microscopy)</p></td><td rowspan=\"2\" style=\"white-space:pre-wrap;width:61.3pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Microscopy wet film </p><p style=\"margin:0;margin-bottom:8pt;\">HVS</p><p style=\"margin:0;margin-bottom:8pt;\">No pseudohyphea in candida Glabrata</p><p style=\"margin:0;margin-bottom:8pt;\">Neutrophils \u2013 candida albicans</p><p style=\"margin:0;margin-bottom:8pt;\">Blastophores \u2013 Candida Albicans</p><p style=\"margin:0;margin-bottom:8pt;\">Psendo hyphae \u2013 Candida Albicans</p><p style=\"margin:0;margin-bottom:8pt;\">Culture</p><p style=\"margin:0;margin-bottom:8pt;\">Sabouraud media</p></td><td style=\"white-space:pre-wrap;width:65.3pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*Fluconazole 150 P/O or *clotrimazole 500mg p/v</p><p style=\"margin:0;margin-bottom:8pt;\">*Severe Fluconazole D1 &amp; D4 or clotrimazole 500 D1 &amp; D4</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:54.4pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Clotrimazole cream 5g stat or clotrimazole pessary 200mg 3 nights.</p></td><td rowspan=\"2\" style=\"white-space:pre-wrap;width:65.65pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*Fluconazole daily for 72 hours then weekly for 6m0 or *clotrimazole or topical imidazole daily 7 \u2013 14days till response then 6m0 *or clotrimazole 500 weekly or * 50 \u2013 100/day.</p></td><td rowspan=\"2\" style=\"white-space:pre-wrap;width:63.15pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Not recommended</p></td><td rowspan=\"2\" style=\"white-space:pre-wrap;width:61.5pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Not recommended</p></td><td rowspan=\"2\" style=\"white-space:pre-wrap;width:51.05pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Pregnancy</p><p style=\"margin:0;margin-bottom:8pt;\">- topical or I/V</p><p style=\"margin:0;margin-bottom:8pt;\">- longer course clotrimazole 500 for 7ays</p></td></tr><tr data-mm-row-height-twips=\"1414\" data-mm-row-height-rule=\"auto\"><td colspan=\"2\" style=\"white-space:pre-wrap;width:119.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;text-align:center;margin-bottom:8pt;\">Non Albicans</p><p style=\"margin:0;margin-bottom:8pt;\">Nystatin 100000 p/v 12-14nights.</p><p style=\"margin:0;margin-bottom:8pt;\">Boric acid or amphotericin B or flucytosine cream</p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6287]\"><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>Table </em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>12</em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>. </em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>2.</em></span><span class=\"mm-tab\" aria-hidden=\"true\">\t</span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>GENITAL INFECTIONS AND THEIR MANAGEMENT</em></span><span class=\"mm-run\" style='color: ##44546A; font-family: \"Calibri\", sans-serif; font-size: 9pt'><em>S</em></span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6288]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6289]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6290]\">\u00a0</p>\n<div class=\"mm-table-scroll\" role=\"region\" tabindex=\"0\"><table class=\"mm-table\" style=\"border-collapse:collapse;table-layout:fixed;margin-left:0pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;\"><colgroup><col style=\"width:58.25pt;\"><col style=\"width:56.15pt;\"><col style=\"width:60.85pt;\"><col style=\"width:57.4pt;\"><col style=\"width:63.9pt;\"><col style=\"width:49.45pt;\"><col style=\"width:64.8pt;\"><col style=\"width:61.5pt;\"><col style=\"width:67.2pt;\"></colgroup><tbody><tr><td style=\"white-space:pre-wrap;width:58.25pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Infection</p></td><td style=\"white-space:pre-wrap;width:56.15pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">%ages</p></td><td style=\"white-space:pre-wrap;width:60.85pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Diagnosis</p></td><td style=\"white-space:pre-wrap;width:57.4pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">T/m</p></td><td style=\"white-space:pre-wrap;width:63.9pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Alternative</p></td><td style=\"white-space:pre-wrap;width:49.45pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Recurrence</p></td><td style=\"white-space:pre-wrap;width:64.8pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">TOC</p></td><td style=\"white-space:pre-wrap;width:61.5pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Partner screening</p></td><td style=\"white-space:pre-wrap;width:67.2pt;background-color:#B4C6E7;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Special note</p></td></tr><tr data-mm-row-height-twips=\"5964\" data-mm-row-height-rule=\"auto\"><td style=\"white-space:pre-wrap;width:58.25pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Neisseria Gonorrhea</p><p style=\"margin:0;margin-bottom:8pt;\">- mucopurulent dx</p><p style=\"margin:0;margin-bottom:8pt;\">- Major cause of testicular system.</p><p style=\"margin:0;margin-bottom:8pt;\">- Affecting urethra</p><p style=\"margin:0;margin-bottom:8pt;\">- Urinary symptoms.</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:56.15pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">- 50% asymptomatic.</p><p style=\"margin:0;margin-bottom:8pt;\">- 90% symptoms in male</p><p style=\"margin:0;margin-bottom:8pt;\">- 19% with NG has CT +ve</p></td><td style=\"white-space:pre-wrap;width:60.85pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">- Microscopy in symptomatic pts:</p><p style=\"margin:0;margin-bottom:8pt;\">- Urethral/ meatal swab/ Rectal</p><p style=\"margin:0;margin-bottom:8pt;\">- Phalangeal swabs NR</p><p style=\"margin:0;margin-bottom:8pt;\">NAAT ideal.</p><p style=\"margin:0;margin-bottom:8pt;\">- 1st pass urine</p><p style=\"margin:0;margin-bottom:8pt;\">- Swabs (Rectal, Phalangeal, VVS)</p><p style=\"margin:0;margin-bottom:8pt;\">Culture all pts</p><p style=\"margin:0;margin-bottom:8pt;\">- purpose to check susceptibility</p></td><td style=\"white-space:pre-wrap;width:57.4pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">- Ceftriaxone 1g I/M stat if susceptibility unknown or</p><p style=\"margin:0;margin-bottom:8pt;\">- Cipro 500mg p/o x stat if susceptibility known (36% are resistant to Cipro).</p></td><td style=\"white-space:pre-wrap;width:63.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*Cefixime 400mg + azthro 2g stat or</p><p style=\"margin:0;margin-bottom:8pt;\">*Gentamycin 240mg I/M + azthro 2g p/o stet</p><p style=\"margin:0;margin-bottom:8pt;\">or</p><p style=\"margin:0;margin-bottom:8pt;\">*Spectinomycin I/M + Azthro 2g p/o</p></td><td style=\"white-space:pre-wrap;width:49.45pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p></td><td style=\"white-space:pre-wrap;width:64.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*All pts *culture after 72 hours of completion of t/m.</p></td><td style=\"white-space:pre-wrap;width:61.5pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Recommended</p><p style=\"margin:0;margin-bottom:8pt;\">- Asymptomatic +ve NG or infection of other sites.</p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"5dd22c7260ee6beb0164ce84\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 5dd22c7260ee6beb0164ce84\" viewbox=\"447675 -47625 257175 504825\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"9a7cb8ae8e4d981c014760bf9f709754d6e4d449fc92316ca5a8c2dea4b3133b\"><defs><marker id=\"arrow-end-2b012a49843e144f271f\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"2b012a49843e144f271f\" transform=\"translate(577215 5080)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 342900\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-2b012a49843e144f271f)\"></path></g></g></svg></figure></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">3m0 all partners.</p><p style=\"margin:0;margin-bottom:8pt;\">- Symptomatic urethral NG</p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"2582e8bf038df102f878cc93\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 2582e8bf038df102f878cc93\" viewbox=\"409575 -47625 257175 485775\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"8d52cd66d033ce1fe81b371ae97f5f4c4db5fa7179d9cfca2a4337618864cd8c\"><defs><marker id=\"arrow-end-614c8b331c41d308360d\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"614c8b331c41d308360d\" transform=\"translate(536756 5261)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 318408\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-614c8b331c41d308360d)\"></path></g></g></svg></figure></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">All partners within 2 weeks</p></td><td style=\"white-space:pre-wrap;width:67.2pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*Conjunctivitis \u2013 1g ceftriaxone</p><p style=\"margin:0;margin-bottom:8pt;\">*Disseminated 1g I/M, I/V ceftriaxone 24 hourly.</p><p style=\"margin:0;margin-bottom:8pt;\">Or </p><p style=\"margin:0;margin-bottom:8pt;\">Cefotaxime 1g -8 hourly I/V. or</p><p style=\"margin:0;margin-bottom:8pt;\">Cipro500mg I/V, B.D</p><p style=\"margin:0;margin-bottom:8pt;\">Spectinomycin 2g I/M B.D</p><p style=\"margin:0;margin-bottom:8pt;\">*Pregnancy Cipro avoid</p><p style=\"margin:0;margin-bottom:8pt;\">*HIV same t/m</p><p style=\"margin:0;margin-bottom:8pt;\">*NG + CT if azthro taken before then only NG t/m.</p></td></tr><tr><td style=\"white-space:pre-wrap;width:58.25pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">chlamydia Trachomatis </p><p style=\"margin:0;margin-bottom:8pt;\">20 \u2013 40age.</p><p style=\"margin:0;margin-bottom:8pt;\">- No Urinary symptoms.</p><p style=\"margin:0;margin-bottom:8pt;\">-Neonatal conjunctivitis &gt;5days.</p><p style=\"margin:0;margin-bottom:8pt;\">- Acute cervicitis.</p></td><td style=\"white-space:pre-wrap;width:56.15pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">15 \u2013 19y = 1.5 \u2013 4.3%</p><p style=\"margin:0;margin-bottom:8pt;\">50% resolve spontaneously over 12m0.</p><p style=\"margin:0;margin-bottom:8pt;\">Rectal 3 \u2013 50% in MSM 70% in heterosexual.</p><p style=\"margin:0;margin-bottom:8pt;\">Phalangeal 0.5 \u2013 2.3% MSM</p><p style=\"margin:0;margin-bottom:8pt;\">SARA 1%</p><p style=\"margin:0;margin-bottom:8pt;\">PID 16%</p><p style=\"margin:0;margin-bottom:8pt;\">Subfertility 1 \u2013 20% after PID</p><p style=\"margin:0;margin-bottom:8pt;\">Periportal Adhesions</p><p style=\"margin:0;margin-bottom:8pt;\">5 \u2013 10%.</p><p style=\"margin:0;margin-bottom:8pt;\">Co \u2013 infections with Mycoplasma 3 \u2013 15%.</p><p style=\"margin:0;margin-bottom:8pt;\">- 54% resolve spontaneously after 1yr.</p></td><td style=\"white-space:pre-wrap;width:60.85pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">NAAT</p><p style=\"margin:0;margin-bottom:8pt;\">- VVS in women.</p><p style=\"margin:0;margin-bottom:8pt;\">- FCU in men.</p><p style=\"margin:0;margin-bottom:8pt;\">- Rectal swab.</p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">- LG V Testing</p><p style=\"margin:0;margin-bottom:8pt;\">- All pts with proctitis.</p><p style=\"margin:0;margin-bottom:8pt;\">- HIV + MSM without proctitis but positive CT.</p></td><td style=\"white-space:pre-wrap;width:57.4pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Uncomplicated</p><p style=\"margin:0;margin-bottom:8pt;\">Doxycycline 100mg B.D \u2013 7D.</p><p style=\"margin:0;margin-bottom:8pt;\">Or</p><p style=\"margin:0;margin-bottom:8pt;\">Azthro 2g stat</p><p style=\"margin:0;margin-bottom:8pt;\">Rectal </p><p style=\"margin:0;margin-bottom:8pt;\">Doxycycline</p></td><td style=\"white-space:pre-wrap;width:63.9pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">Genital</p><p style=\"margin:0;margin-bottom:8pt;\">Erythromycin 500 BD for 10 \u2013 14D</p><p style=\"margin:0;margin-bottom:8pt;\">Or</p><p style=\"margin:0;margin-bottom:8pt;\">Ofloxacin 200mg BD</p><p style=\"margin:0;margin-bottom:8pt;\">Or</p><p style=\"margin:0;margin-bottom:8pt;\">Ofloxacin 400 OD</p><p style=\"margin:0;margin-bottom:8pt;\">Rectal Azithromycin.</p></td><td style=\"white-space:pre-wrap;width:49.45pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*2 \u2013 5m0 after previous infection * so repeat testing 3m0 after t/m.</p></td><td style=\"white-space:pre-wrap;width:64.8pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">NR = Routinely *recommended</p><p style=\"margin:0;margin-bottom:8pt;\">*Pregnancy 6 weeks.</p><p style=\"margin:0;margin-bottom:8pt;\">*Symptoms persists</p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"832c6e164664ac96739f5b62\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 832c6e164664ac96739f5b62\" viewbox=\"504825 -9525 257175 485775\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"32b001637fc2b81e9c9bace26d4da6c81980e93e40668602b649cbb7ae4f6d4c\"><defs><marker id=\"arrow-end-52ead16a674322631b46\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"52ead16a674322631b46\" transform=\"translate(632188 43815)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 1 318408\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-52ead16a674322631b46)\"></path></g></g></svg></figure></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Swabs and PCR </p><p style=\"margin:0;margin-bottom:8pt;\">CT Persists for 3 \u2013 5weeks so TOC NR routinely.</p></td><td style=\"white-space:pre-wrap;width:61.5pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">ALL</p></td><td style=\"white-space:pre-wrap;width:67.2pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\">*HIV +ve</p><p style=\"margin:0;margin-bottom:8pt;\">Genital &amp; pharyngeal CT same as HIV \u2013ve.</p><p style=\"margin:0;margin-bottom:8pt;\">*HIV +ve</p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"d9949dac3b43579c82e9fb3e\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure d9949dac3b43579c82e9fb3e\" viewbox=\"514350 95250 257175 361950\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"0d091f7b64920bd19689695ae87361f726eacbfdab8ad16165c380e97b0fcb56\"><defs><marker id=\"arrow-end-18e0e03af35b005e55ad\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"18e0e03af35b005e55ad\" transform=\"translate(641964 141543)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 3748 202367\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-18e0e03af35b005e55ad)\"></path></g></g></svg></figure>Rectal CT</p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"89adc96cb7638ffcb3067dfe\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 89adc96cb7638ffcb3067dfe\" viewbox=\"438150 76200 628650 390525\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"4517f0fb302a701bbdc3ed7086f8a1530755cd237ed6bc7b007e3da09ddc3569\"><defs><marker id=\"arrow-end-ca5dae32da31e7de919f\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker><marker id=\"arrow-end-055bd564610f3e3a6339\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#4472C4\"></path></marker></defs><g data-mm-object-id=\"ca5dae32da31e7de919f\" transform=\"translate(525790 127718)\"><g transform=\"translate(0 0) translate(54339.5 108679) rotate(0) scale(-1 1) translate(-54339.5 -108679)\"><path d=\"M 0 0 L 108679 217358\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-ca5dae32da31e7de919f)\"></path></g></g><g data-mm-object-id=\"055bd564610f3e3a6339\" transform=\"translate(829341 146456)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 127417 213610\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-055bd564610f3e3a6339)\"></path></g></g></svg></figure><span hidden data-mm-figure-member=\"89adc96cb7638ffcb3067dfe\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:tbl[32]/w:tr[3]/w:tc[9]/w:p[6]/w:r[2]/{http://schemas.openxmlformats.org/markup-compatibility/2006}AlternateContent[1]/{http://schemas.openxmlformats.org/markup-compatibility/2006}Choice[1]/w:drawing[1]\"></span>Test LGV</p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"6f9e9534a06b9640686181dd\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 6f9e9534a06b9640686181dd\" viewbox=\"704850 142875 533400 304800\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"efb18c01bbef3b11f5fdf62b47eaaa3409b95768a4970eda65a3ea3ec6300e0b\"><g data-mm-object-id=\"27d105eadf38325a6934\" transform=\"translate(705402 145551)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 532150 0 L 532150 296056 L 0 296056 Z\" fill=\"none\" fill-opacity=\"0\" stroke=\"none\" stroke-opacity=\"0\" stroke-width=\"6350\"></path><g data-mm-text-anchor=\"t\" transform=\"translate(0 45720)\"><text data-mm-wrapped-line=\"0\" x=\"91440\" y=\"152400\" text-anchor=\"start\" xml:space=\"preserve\"></text></g></g></g></svg></figure></p><p style=\"margin:0;margin-bottom:8pt;\"><figure class=\"mm-figure\" data-mm-figure-id=\"29e0f0bee34395f8b2f87f3d\" data-mm-topic-id=\"t-mm-05-002\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 29e0f0bee34395f8b2f87f3d\" viewbox=\"523875 114300 457200 276225\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"93988b84f70746709b7bba82bfc42014ded3b2e950b6772e772f6dec54c46190\"><g data-mm-object-id=\"1754ab126356b331154d\" transform=\"translate(533285 132632)\"><g transform=\"translate(0 0)\"><path d=\"M 0 0 L 213610 224852\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g><g data-mm-object-id=\"93601467848a2f434972\" transform=\"translate(739400 128884)\"><g transform=\"translate(0 0) translate(97436 108679) rotate(0) scale(-1 1) translate(-97436 -108679)\"><path d=\"M 0 0 L 194872 217358\" fill=\"none\" fill-opacity=\"0\" stroke=\"#4472C4\" stroke-opacity=\"1\" stroke-width=\"12700\"></path></g></g></svg></figure><span hidden data-mm-figure-member=\"29e0f0bee34395f8b2f87f3d\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:tbl[32]/w:tr[3]/w:tc[9]/w:p[8]/w:r[2]/{http://schemas.openxmlformats.org/markup-compatibility/2006}AlternateContent[1]/{http://schemas.openxmlformats.org/markup-compatibility/2006}Choice[1]/w:drawing[1]\"></span>+ve        </p><p style=\"margin:0;margin-bottom:8pt;\"></p><p style=\"margin:0;margin-bottom:8pt;\">Doxi 3 wks</p><p style=\"margin:0;margin-bottom:8pt;\">*Pregnancy</p><p style=\"margin:0;margin-bottom:8pt;\">Azthro, Erythro Ampicillin</p><p style=\"margin:0;margin-bottom:8pt;\">NG + CT</p><p style=\"margin:0;margin-bottom:8pt;\">ceftriaxone 500 I/M + Azthro 1g.</p><p style=\"margin:0;margin-bottom:8pt;\">NG + Rectel CT \u2013 ceftriaxone + Doxi + Azthro.</p><p style=\"margin:0;margin-bottom:8pt;\">Neonatal CT</p><p style=\"margin:0;margin-bottom:8pt;\">5-12D oral Erythro</p><p style=\"margin:0;margin-bottom:8pt;\"></p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6291]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6292]\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[6293]\">\u00a0</p>",
