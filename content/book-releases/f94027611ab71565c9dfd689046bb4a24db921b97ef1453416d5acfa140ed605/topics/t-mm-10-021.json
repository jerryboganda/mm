  "topic_id": "t-mm-10-021",
  "book_id": "book-mm-10",
  "title": "3.10.\tSEPSIS",
  "source_sha256": "f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605",
  "block_count": 1,
  "blocks": [
    {
      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-10-021\" hidden></div>\n<div class=\"mm-heading mm-h3 mm-header-banner mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20938]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">10.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>SEPSIS</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20939]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">65.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Early investigations if suspected </span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20940]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">66.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Take into account the normal physiological changes in labor like    ed HR</span></span></div>\n<figure class=\"mm-figure\" data-mm-figure-id=\"5fcecae80e0efe0888f418bc\" data-mm-topic-id=\"t-mm-10-021\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure 5fcecae80e0efe0888f418bc\" viewbox=\"2133600 123825 228600 295275\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"8b567f00344d53dd65b8a3415096d55b74e88247ead5532fcd58b2496fe805ab\"><defs><marker id=\"arrow-end-3ba88c96dd3119ab309f\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"3ba88c96dd3119ab309f\" transform=\"translate(2257063 213440)\"><g transform=\"translate(0 0) translate(0 69448.5) rotate(0) scale(1 -1) translate(0 -69448.5)\"><path d=\"M 0 0 L 1 138897\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-3ba88c96dd3119ab309f)\"></path></g></g></svg></figure>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20941]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">67.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Recognize that sepsis in labor has higher risk of illness or death.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20942]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">68.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT for sepsis in labor.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20943]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Senior obstetrician</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20944]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Senior obstetrician anesthetist</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20945]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Senior midwife</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20946]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Labor ward coordinator</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20947]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Senior neonatologist</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20948]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Senior microbiologist</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20949]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">69.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Include senior intensivist if a woman in labor with sepsis has any of the following sign of organ dysfunction</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20950]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Altered consciousness</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20951]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hypotension (systolic B.P &lt; 90mmHg)</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20952]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Reduced </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>UOP</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (&lt; 0.5ml/kg per hour)</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20953]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>4. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Need for 40% oxygen to maintain oxygen saturation above 92%.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20954]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Tympanic temperature of &lt; 36</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><sup>0</sup></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>C.</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20955]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">70.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Women with sepsis in labor should have </span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20956]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Clear and agreed MDT care plan</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20957]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Documentation of Plan</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20958]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Regular review of Plan according to clinical picture</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20959]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">71.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Involve women and her partner in her care plan and any intervention</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20960]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">72.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Discuss</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> mode and timing of delivery by taking account of</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20961]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>DOP</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20962]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Fetal well \u2013 being</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20963]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Source of sepsis if known</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20964]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Parity</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20965]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Stage and progress of labor</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20966]\" style=\"margin-bottom: 8pt; margin-left: 54pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Response to treatment</span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20967]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">73.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Expedite birth if source is genital tract.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20968]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">74.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Anesthesia</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> \u2013 regional anesthesia with caution after consultant advice.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20969]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">75.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Analg</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>esia in labo</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>u</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>r:</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20970]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Regional analgesia with caution after consultant advice</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20971]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Birthing pool after senior obstetrician or senior midwife\u2019s discussion.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20972]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Antibiotics before inserting the needle of regional analgesia</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20973]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT review regarding pain relief every 4 hours.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20974]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">76.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Fetal Monitoring</strong></u></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> \u2013 continuous</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20975]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">77.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>antimicrobial drugs</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20976]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Send culture before giving antimicrobial</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20977]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Start broad spectrum empirical therapy after sending culture.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20978]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Choice of antibiotics according to local antimicrobial guidelines.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20979]\" style=\"margin-bottom: 8pt; padding-left: 18pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">78.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Post - natal care</strong></u></span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20980]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT within 24 hours of birth</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20981]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>MDT discussion includes</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20982]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>1. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Specimens for culture</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20983]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Antimicrobial treatment</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20984]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>3.    </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ed frequency of monitoring</span></p>\n<figure class=\"mm-figure\" data-mm-figure-id=\"d8690442ec9ce8751554b50c\" data-mm-topic-id=\"t-mm-10-021\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Source figure d8690442ec9ce8751554b50c\" viewbox=\"1438275 -85725 238125 314325\" preserveaspectratio=\"xMidYMid meet\" data-mm-object-manifest=\"93dbb7e442e8b175c174cc0e60951d9432b65c0d0f8c94dd20a162d613837f5e\"><defs><marker id=\"arrow-end-ad2238dbf76de6bb9100\" markerwidth=\"10\" markerheight=\"7\" refx=\"9\" refy=\"3.5\" orient=\"auto\" markerunits=\"strokeWidth\"><path d=\"M 0 0 L 10 3.5 L 0 7 Z\" fill=\"#000000\"></path></marker></defs><g data-mm-object-id=\"ad2238dbf76de6bb9100\" transform=\"translate(1567815 3810)\"><g transform=\"translate(0 0) translate(0 74930) rotate(0) scale(1 -1) translate(0 -74930)\"><path d=\"M 0 0 L 1 149860\" fill=\"none\" fill-opacity=\"0\" stroke=\"#000000\" stroke-opacity=\"1\" stroke-width=\"12700\" marker-end=\"url(#arrow-end-ad2238dbf76de6bb9100)\"></path></g></g></svg></figure>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20985]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>4. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Enhance level of care and</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20986]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>monitoring</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20987]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>5. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Further investigations such as imaging.</span></p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[20988]\" style=\"margin-bottom: 8pt; margin-left: 72pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>6. </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Additional support</span></p>",
      "content_sha256": "8922cab362b4759e6e387de3b1bffa4975974b26fee50f7c695497aa720cd7cc",
      "block_type": "document_html"
    }
  ]
}