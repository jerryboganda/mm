      "order": 0,
      "content": "<div class=\"mm-release-marker\" data-mm-release=\"f94027611ab71565c9dfd689046bb4a24db921b97ef1453416d5acfa140ed605\" data-mm-topic=\"t-mm-09-010\" hidden></div>\n<div class=\"mm-heading mm-h3 mm-header-banner mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16755]\" style=\"background-color: #9CC2E5; color: #FFFFFF; padding: 6px 12px; border-radius: 4px; font-weight: 700; margin-top: 8pt; margin-bottom: 4pt; padding-left: 108pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">1.9.</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>  </span><span class=\"mm-run\" style='color: #FFFFFF; font-family: \"Calibri Light\", sans-serif; font-size: 14pt'>TOXOPLASMOSIS</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16756]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>2/1000 pregnancies in UK.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16757]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Recurrence in HIV mothers.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16758]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Parasitemia within 3 weeks.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16759]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Risk of congenital </strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>sequalae &amp; complications</strong></span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16760]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Early = 85%.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16761]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Late = 10 \u2013 80%.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16762]\" style=\"text-align: center\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><u><strong>Mother to child transmission:</strong></u></span></p>\n<div class=\"mm-table-scroll\" role=\"region\" tabindex=\"0\"><table class=\"mm-table\" style=\"border-collapse:collapse;margin-left:18pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;\"><colgroup><col style=\"width:81.55pt;\"><col style=\"width:75.9pt;\"><col style=\"width:76.05pt;\"></colgroup><tbody><tr><td style=\"white-space:pre-wrap;width:89.7pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><strong>trimester</strong></span></p></td><td style=\"white-space:pre-wrap;width:89.7pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><strong>CMV</strong></span></p></td><td style=\"white-space:pre-wrap;width:89.75pt;background-color:#BDD6EE;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><strong>Risk of </strong></span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><strong>Toxo</strong></span></p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>1</span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><sup>st</sup></span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'> </span></p></td><td style=\"white-space:pre-wrap;width:89.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>40%</span></p></td><td style=\"white-space:pre-wrap;width:89.75pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>10%</span></p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>2</span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><sup>nd</sup></span></p></td><td style=\"white-space:pre-wrap;width:89.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>40%</span></p></td><td style=\"white-space:pre-wrap;width:89.75pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>25%</span></p></td></tr><tr><td style=\"white-space:pre-wrap;width:89.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>3</span><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'><sup>rd</sup></span></p></td><td style=\"white-space:pre-wrap;width:89.7pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>80%</span></p></td><td style=\"white-space:pre-wrap;width:89.75pt;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-top:0pt;padding-right:5.4pt;padding-bottom:0pt;padding-left:5.4pt;\"><p style=\"margin:0;margin-bottom:8pt;\"><span class=\"mm-run\" style='font-family:\"Calibri\", sans-serif;font-size:12pt'>&gt; 85%</span></p></td></tr></tbody></table></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16763]\" style=\"margin-bottom: 8pt\">\u00a0</p>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16764]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Toxo Triad:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16765]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>I</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ntra </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>cerebral calcifications.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16766]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrocephaly</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16767]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Chorioretinitis.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16768]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Diagnosis:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16769]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Routine screening not recommended.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16770]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Serial USG to detect markers</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16771]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ascites.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16772]\" style=\"margin-bottom: 8pt; padding-left: 72pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">-</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='color: #2F5496; font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hepatosplenomegaly.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16773]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Tests:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16774]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>ELI</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Z</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>A = enzyme \u2013 linked immune filtration assay.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16775]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>PCR of </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>amniotic fluid is</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> highly accurate.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16776]\" style=\"margin-bottom: 8pt\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Implications:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16777]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Miscarriages.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16778]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ascites/ hepatosplenomegaly.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16779]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Chorioretinitis.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16780]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Hydrocephaly</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16781]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Brain tissue calcification.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16782]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Visual impairment of fetus.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16783]\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'><strong>Management:</strong></span></p>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16784]\" style=\"padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Ant</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>i</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>parasitic \u2013 prevent fetal damage after transmission.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16785]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Not possible to eradicate.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16786]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>TOP is an option.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16787]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Spiramycin to prevent congenital infections.</span></span></div>\n<div class=\"mm-para mm-list-item\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16788]\" style=\"margin-bottom: 8pt; padding-left: 36pt\"><span class=\"mm-list-marker\" aria-hidden=\"true\">\u2022</span><span class=\"mm-list-body\"><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>Sulphadiazine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>/ pyrimethamine</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> given only </span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>if infection is confirmed</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'> (can be toxic)</span><span class=\"mm-run\" style='font-family: \"Calibri\", sans-serif; font-size: 12pt'>.</span></span></div>\n<p class=\"mm-para\" data-mm-source-path=\"word/document.xml/w:document[1]/w:body[1]/w:p[16789]\" style=\"margin-bottom: 8pt\">\u00a0</p>",
      "content_sha256": "4b0bbe4683154c3f35e80b5252687f103b817bba943ddd92145b1f01cc47796b",
      "block_type": "document_html"
    }
  ]
}